<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - QSI</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="../js/qsi-styles.css">
  <style>
    .settings-container {
      max-width: 900px;
      margin: 0 auto;
    }

    .tab-button {
      padding: 1rem 0.25rem;
      border-bottom: 2px solid transparent;
      font-size: 0.875rem;
      font-weight: 500;
      background: none;
      cursor: pointer;
      white-space: nowrap;
    }

    .tab-active {
      border-bottom-color: var(--primary-500);
      color: var(--primary-500);
      font-weight: 600;
    }

    .tab-inactive {
      color: var(--gray-500);
    }

    .tab-inactive:hover {
      color: var(--gray-700);
      border-bottom-color: var(--gray-300);
    }

    .theme-dark .tab-inactive {
      color: var(--dark-text-muted);
    }

    .settings-card {
      background: #fff;
      padding: 1.5rem;
      border-radius: 0.75rem;
      border: 1px solid var(--gray-200);
      margin-bottom: 1.5rem;
    }

    .theme-dark .settings-card {
      background: var(--dark-bg-card);
      border-color: var(--dark-border);
    }

    .settings-card-title {
      font-size: 1.25rem;
      font-weight: 600;
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--gray-200);
    }

    .theme-dark .settings-card-title {
      color: var(--dark-text-primary);
      border-color: var(--dark-border);
    }

    .settings-form-group {
      margin-bottom: 1.25rem;
    }

    .settings-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--gray-700);
      margin-bottom: 0.5rem;
    }

    .theme-dark .settings-label {
      color: var(--dark-text-muted);
    }

    .settings-input {
      width: 100%;
      padding: 0.625rem 1rem;
      font-size: 0.875rem;
      border: 1px solid var(--gray-300);
      border-radius: 0.5rem;
      background: #fff;
      color: var(--gray-900);
    }

    .settings-input:focus {
      outline: none;
      border-color: var(--primary-500);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }

    .theme-dark .settings-input {
      background: var(--dark-bg-primary);
      border-color: var(--dark-border);
      color: var(--dark-text-secondary);
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }

      .main-content {
        margin-top: 4rem;
      }
    }

    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }

    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .toggle-slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background: var(--gray-300);
      border-radius: 24px;
      transition: 0.3s;
    }

    .toggle-slider:before {
      content: "";
      position: absolute;
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background: white;
      border-radius: 50%;
      transition: 0.3s;
    }

    input:checked+.toggle-slider {
      background: var(--primary-500);
    }

    input:checked+.toggle-slider:before {
      transform: translateX(20px);
    }

    .theme-option {
      display: flex;
      align-items: center;
      padding: 1rem;
      border: 2px solid var(--gray-200);
      border-radius: 0.75rem;
      cursor: pointer;
      margin-bottom: 0.75rem;
    }

    .theme-option:hover {
      border-color: var(--primary-300);
      background: var(--gray-50);
    }

    .theme-option.selected {
      border-color: var(--primary-500);
      background: var(--primary-50);
    }

    .theme-dark .theme-option {
      border-color: var(--dark-border);
      background: var(--dark-bg-tertiary);
    }

    .theme-dark .theme-option.selected {
      border-color: var(--primary-500);
      background: rgba(99, 102, 241, 0.15);
    }

    .theme-option-icon {
      width: 48px;
      height: 48px;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 1rem;
      font-size: 1.25rem;
    }

    .theme-option-light .theme-option-icon {
      background: linear-gradient(135deg, #f9fafb, #e5e7eb);
      color: var(--gray-700);
    }

    .theme-option-dark .theme-option-icon {
      background: linear-gradient(135deg, #1f2937, #111827);
      color: #fff;
    }

    .theme-option-system .theme-option-icon {
      background: linear-gradient(135deg, #f9fafb 50%, #1f2937 50%);
      color: var(--primary-500);
    }

    .theme-option-info {
      flex: 1;
    }

    .theme-option-title {
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .theme-dark .theme-option-title {
      color: var(--dark-text-primary);
    }

    .theme-option-description {
      font-size: 0.8125rem;
      color: var(--gray-500);
    }

    .theme-option-check {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid var(--gray-300);
      display: flex;
      align-items: center;
      justify-content: center;
      color: transparent;
    }

    .theme-option.selected .theme-option-check {
      background: var(--primary-500);
      border-color: var(--primary-500);
      color: white;
    }

    .danger-zone {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 0.75rem;
      padding: 1.5rem;
    }

    .danger-zone-title {
      color: var(--danger-600);
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      opacity: 0;
      transform: translateY(0.5rem);
      transition: 0.3s;
      z-index: 9999;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .toast-success {
      background: var(--success-500);
      color: white;
    }

    .toast-error {
      background: var(--danger-500);
      color: white;
    }

    .sticky-header {
      position: sticky;
      top: 0;
      z-index: 20;
      padding-top: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .theme-dark .sticky-header {
      background: var(--dark-bg-primary);
    }

    .theme-light .sticky-header {
      background: var(--light-bg-secondary);
    }

    .bank-card {
      border: 1px solid var(--gray-200);
      border-radius: 0.5rem;
      padding: 1rem;
      margin-bottom: 0.75rem;
    }

    .theme-dark .bank-card {
      border-color: var(--dark-border);
      background: var(--dark-bg-tertiary);
    }

    .logo-preview {
      width: 80px;
      height: 80px;
      border-radius: 0.5rem;
      object-fit: contain;
      border: 1px solid var(--gray-200);
      background: white;
    }

    .btn-spinner {
      width: 1.25rem;
      height: 1.25rem;
      border: 2px solid transparent;
      border-top-color: currentColor;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .settings-modal {
      position: fixed;
      inset: 0;
      z-index: 1050;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .settings-modal.active {
      display: flex;
    }

    .settings-modal-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
    }

    .settings-modal-content {
      position: relative;
      background: #fff;
      border-radius: 0.75rem;
      width: 100%;
      max-width: 32rem;
      max-height: 90vh;
      overflow-y: auto;
    }

    .theme-dark .settings-modal-content {
      background: var(--dark-bg-card);
      border: 1px solid var(--dark-border);
    }

    .required {
      color: var(--danger-500);
    }

    .text-muted {
      color: var(--gray-500);
    }

    .theme-dark .text-muted {
      color: var(--dark-text-muted);
    }

    .tabs-nav {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .tabs-nav::-webkit-scrollbar {
      display: none;
    }
  </style>
</head>

<body class="theme-light">
  <div class="flex">
    <!-- Mobile Header -->
    <header class="mobile-header" style="background: var(--dark-bg-secondary);">
      <div class="flex items-center gap-3">
        <button id="menu-toggle" class="menu-toggle"><i class="fas fa-bars"></i></button>
        <span class="text-lg font-bold text-white">QSI</span>
      </div>
    </header>
    <div id="menu-backdrop" class="backdrop"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar">
      <div class="p-4 border-b" style="border-color: var(--dark-border);"><span
          class="text-xl font-bold text-white">QSI</span></div>
      <nav class="sidebar-nav">
        <a href="dashboard_with_login.html" class="sidebar-link"><i
            class="fas fa-chart-pie"></i><span>Dashboard</span></a>
        <div class="sidebar-section">Sales</div>
        <a href="quotation/home_quotation.html" class="sidebar-link"><i
            class="fas fa-file-alt"></i><span>Quotation</span></a>
        <a href="invoice/home_invoice.html" class="sidebar-link"><i
            class="fas fa-file-invoice"></i><span>Invoice</span></a>
        <div class="sidebar-section">Purchases</div>
        <a href="parchase/vendor/vendors_leads.html" class="sidebar-link"><i
            class="fas fa-store"></i><span>Vendors</span></a>
        <a href="parchase/home_bills.html" class="sidebar-link"><i class="fas fa-file-alt"></i><span>Bills</span></a>
        <div class="sidebar-section">Others</div>
        <a href="manage-clients.html" class="sidebar-link"><i class="fas fa-users"></i><span>Clients</span></a>
        <a href="settings.html" class="sidebar-link active"><i class="fas fa-cog"></i><span>Settings</span></a>
      </nav>
      <div class="sidebar-profile" id="user-profile-btn">
        <img id="sidebar-avatar" src="https://placehold.co/40x40/3b82f6/ffffff?text=U" alt="User">
        <div class="sidebar-profile-info">
          <p id="sidebar-name" class="sidebar-profile-name">User</p>
          <p id="sidebar-email" class="sidebar-profile-email">user@email.com</p>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <div class="content-wrapper">
        <div class="settings-container">
          <!-- Sticky Header -->
          <div class="sticky-header">
            <header class="mb-4">
              <h1 class="text-2xl font-bold">Settings</h1>
              <p class="text-muted text-sm">Manage your account and preferences.</p>
            </header>
            <div class="border-b" style="border-color: var(--gray-200);">
              <nav class="tabs-nav flex gap-6">
                <button data-tab="profile" class="tab-button tab-active">Profile</button>
                <button data-tab="business" class="tab-button tab-inactive">Business</button>
                <button data-tab="bank" class="tab-button tab-inactive">Bank</button>
                <button data-tab="notifications" class="tab-button tab-inactive">Notifications</button>
                <button data-tab="security" class="tab-button tab-inactive">Security</button>
                <button data-tab="theme" class="tab-button tab-inactive">Theme</button>
              </nav>
            </div>
          </div>

          <!-- PROFILE TAB -->
          <section id="tab-profile" class="tab-content">
            <div class="settings-card">
              <h2 class="settings-card-title">Personal Information</h2>
              <form id="profile-form">
                <div class="grid-2">
                  <div class="settings-form-group">
                    <label for="fullName" class="settings-label">Username</label>
                    <input type="text" id="fullName" class="settings-input" placeholder="Your name">
                  </div>
                  <div class="settings-form-group">
                    <label for="email" class="settings-label">Email</label>
                    <input type="email" id="email" class="settings-input" placeholder="you@example.com">
                  </div>
                </div>
                <div class="grid-2">
                  <div class="settings-form-group">
                    <label for="phone" class="settings-label">Phone</label>
                    <input type="tel" id="phone" class="settings-input" placeholder="+91 9876543210">
                  </div>
                  <div class="settings-form-group">
                    <label for="personal_country" class="settings-label">Country</label>
                    <select id="personal_country" class="settings-input">
                      <option value="">Select Country</option>
                    </select>
                  </div>
                </div>
                <div class="flex justify-end mt-4">
                  <button type="submit" id="save-profile-btn" class="btn btn-primary"
                    style="width:auto;min-width:140px;">Save Changes</button>
                </div>
              </form>
            </div>
          </section>

          <!-- BUSINESS TAB -->
          <section id="tab-business" class="tab-content hidden">
            <div class="settings-card">
              <h2 class="settings-card-title">Business Information</h2>
              <form id="business-form">
                <div class="grid-2">
                  <div class="settings-form-group">
                    <label for="businessName" class="settings-label">Business Name <span
                        class="required">*</span></label>
                    <input type="text" id="businessName" class="settings-input" placeholder="Your Company LLC" required>
                    <div class="mt-4 flex items-center gap-4">
                      <img id="business-logo-preview" src="https://placehold.co/80x80/f3f4f6/9ca3af?text=Logo"
                        alt="Logo" class="logo-preview">
                      <div>
                        <label class="settings-label">Company Logo</label>
                        <input type="file" id="logo" accept="image/png,image/jpeg" class="text-sm">
                        <p class="text-xs text-muted mt-1">PNG/JPG, 300x300 recommended</p>
                      </div>
                    </div>
                  </div>
                  <div class="settings-form-group">
                    <label for="teamSize" class="settings-label">Team Size <span class="required">*</span></label>
                    <select id="teamSize" class="settings-input" required>
                      <option value="">Select Size</option>
                      <option value="1">Just Me</option>
                      <option value="2">2-5</option>
                      <option value="6">6-10</option>
                      <option value="11">11+</option>
                    </select>
                  </div>
                </div>
                <div class="settings-form-group">
                  <label for="website" class="settings-label">Website</label>
                  <input type="url" id="website" class="settings-input" placeholder="https://your-website.com">
                </div>
                <div class="grid-2">
                  <div class="settings-form-group">
                    <label for="business_phone" class="settings-label">Phone <span class="required">*</span></label>
                    <input type="tel" id="business_phone" class="settings-input" required>
                  </div>
                  <div class="settings-form-group">
                    <label for="business_email" class="settings-label">Email <span class="required">*</span></label>
                    <input type="email" id="business_email" class="settings-input" required>
                  </div>
                </div>
                <div class="grid-2">
                  <div class="settings-form-group">
                    <label for="gst" class="settings-label">GST Number</label>
                    <input type="text" id="gst" class="settings-input" placeholder="Optional">
                  </div>
                  <div class="settings-form-group">
                    <label for="currency" class="settings-label">Currency <span class="required">*</span></label>
                    <select id="currency" class="settings-input" required>
                      <option value="">Select</option>
                      <option value="INR">INR (₹)</option>
                      <option value="USD">USD ($)</option>
                      <option value="EUR">EUR (€)</option>
                      <option value="GBP">GBP (£)</option>
                    </select>
                  </div>
                </div>
                <div class="pt-4 mt-4 border-t" style="border-color:var(--gray-200);">
                  <h3 class="font-semibold mb-4">Business Address</h3>
                  <div class="settings-form-group">
                    <label for="street" class="settings-label">Street <span class="required">*</span></label>
                    <input type="text" id="street" class="settings-input" required>
                  </div>
                  <div class="grid-2">
                    <div class="settings-form-group">
                      <label for="city" class="settings-label">City <span class="required">*</span></label>
                      <input type="text" id="city" class="settings-input" required>
                    </div>
                    <div class="settings-form-group">
                      <label for="state" class="settings-label">State <span class="required">*</span></label>
                      <input type="text" id="state" class="settings-input" required>
                    </div>
                  </div>
                  <div class="grid-2">
                    <div class="settings-form-group">
                      <label for="pincode" class="settings-label">Pincode <span class="required">*</span></label>
                      <input type="text" id="pincode" class="settings-input" required>
                    </div>
                    <div class="settings-form-group">
                      <label for="business_country" class="settings-label">Country <span
                          class="required">*</span></label>
                      <select id="business_country" class="settings-input" required>
                        <option value="">Select</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="flex justify-end mt-4">
                  <button type="submit" id="save-business-btn" class="btn btn-primary"
                    style="width:auto;min-width:160px;">Update Business</button>
                </div>
              </form>
            </div>
          </section>

          <!-- BANK TAB -->
          <section id="tab-bank" class="tab-content hidden">
            <div class="settings-card">
              <div class="flex justify-between items-center mb-6">
                <h2 class="settings-card-title" style="border:none;padding:0;margin:0;">Bank Accounts</h2>
                <button id="add-bank-btn" class="btn btn-primary" style="width:auto;"><i
                    class="fas fa-plus mr-2"></i>Add Bank</button>
              </div>
              <div id="banks-list">
                <div class="empty-state">
                  <i class="fas fa-university empty-state-icon"></i>
                  <p class="empty-state-title">No bank accounts</p>
                  <p class="empty-state-text">Add your first bank account.</p>
                </div>
              </div>
            </div>
          </section>

          <!-- NOTIFICATIONS TAB -->
          <section id="tab-notifications" class="tab-content hidden">
            <div class="settings-card">
              <h2 class="settings-card-title">Notification Preferences</h2>
              <div class="space-y-4">
                <div class="flex items-center justify-between py-4 border-b" style="border-color:var(--gray-200);">
                  <div>
                    <h3 class="font-medium">Email Notifications</h3>
                    <p class="text-sm text-muted">Receive emails about activity.</p>
                  </div>
                  <label class="toggle-switch"><input type="checkbox" id="email-notifications"><span
                      class="toggle-slider"></span></label>
                </div>
                <div class="flex items-center justify-between py-4 border-b" style="border-color:var(--gray-200);">
                  <div>
                    <h3 class="font-medium">Order Alerts</h3>
                    <p class="text-sm text-muted">Get notified on new orders.</p>
                  </div>
                  <label class="toggle-switch"><input type="checkbox" id="order-alerts"><span
                      class="toggle-slider"></span></label>
                </div>
                <div class="flex items-center justify-between py-4">
                  <div>
                    <h3 class="font-medium">Weekly Summary</h3>
                    <p class="text-sm text-muted">Weekly activity summary.</p>
                  </div>
                  <label class="toggle-switch"><input type="checkbox" id="weekly-summary"><span
                      class="toggle-slider"></span></label>
                </div>
              </div>
            </div>
          </section>

          <!-- SECURITY TAB -->
          <section id="tab-security" class="tab-content hidden">
            <div class="settings-card">
              <h2 class="settings-card-title">Change Password</h2>
              <form id="password-form">
                <div class="settings-form-group">
                  <label for="currentPassword" class="settings-label">Current Password</label>
                  <div class="flex gap-3">
                    <input type="password" id="currentPassword" class="settings-input"
                      placeholder="Enter current password">
                    <button type="button" id="verify-password-btn" class="btn btn-secondary"
                      style="width:auto;min-width:100px;">Verify</button>
                  </div>
                </div>
                <div id="new-password-section" class="hidden">
                  <div class="grid-2">
                    <div class="settings-form-group">
                      <label for="newPassword" class="settings-label">New Password</label>
                      <input type="password" id="newPassword" class="settings-input">
                    </div>
                    <div class="settings-form-group">
                      <label for="confirmPassword" class="settings-label">Confirm Password</label>
                      <input type="password" id="confirmPassword" class="settings-input">
                    </div>
                  </div>
                  <div class="flex justify-end mt-4">
                    <button type="submit" id="update-password-btn" class="btn btn-primary"
                      style="width:auto;min-width:160px;">Update Password</button>
                  </div>
                </div>
              </form>
            </div>
            <div class="danger-zone">
              <h2 class="danger-zone-title">Danger Zone</h2>
              <div class="flex items-center justify-between flex-wrap gap-4">
                <div>
                  <h3 class="font-medium" style="color:var(--danger-600);">Delete Account</h3>
                  <p class="text-sm" style="color:var(--danger-500);">Permanently deleted after 30 days.</p>
                </div>
                <button id="delete-account-btn" class="btn btn-danger" style="width:auto;">Delete Account</button>
              </div>
            </div>
          </section>

          <!-- THEME TAB -->
          <section id="tab-theme" class="tab-content hidden">
            <div class="settings-card">
              <h2 class="settings-card-title">Appearance</h2>
              <p class="text-sm text-muted mb-6">Choose your theme preference.</p>
              <div id="theme-options">
                <div class="theme-option theme-option-light" data-theme="light">
                  <div class="theme-option-icon"><i class="fas fa-sun"></i></div>
                  <div class="theme-option-info">
                    <h3 class="theme-option-title">Light</h3>
                    <p class="theme-option-description">Bright interface for daytime.</p>
                  </div>
                  <div class="theme-option-check"><i class="fas fa-check text-sm"></i></div>
                </div>
                <div class="theme-option theme-option-dark" data-theme="dark">
                  <div class="theme-option-icon"><i class="fas fa-moon"></i></div>
                  <div class="theme-option-info">
                    <h3 class="theme-option-title">Dark</h3>
                    <p class="theme-option-description">Easy on the eyes.</p>
                  </div>
                  <div class="theme-option-check"><i class="fas fa-check text-sm"></i></div>
                </div>
                <div class="theme-option theme-option-system" data-theme="system">
                  <div class="theme-option-icon"><i class="fas fa-desktop"></i></div>
                  <div class="theme-option-info">
                    <h3 class="theme-option-title">System</h3>
                    <p class="theme-option-description">Match device settings.</p>
                  </div>
                  <div class="theme-option-check"><i class="fas fa-check text-sm"></i></div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast"><span id="toast-message"></span></div>

  <!-- Bank Modal -->
  <div id="bank-modal" class="settings-modal">
    <div class="settings-modal-overlay" id="bank-modal-overlay"></div>
    <div class="settings-modal-content">
      <div class="p-5 border-b" style="border-color:var(--gray-200);">
        <div class="flex justify-between items-center">
          <h3 class="text-lg font-semibold" id="bank-modal-title">Add Bank Account</h3>
          <button id="close-bank-modal" class="btn btn-ghost" style="width:auto;padding:0.5rem;"><i
              class="fas fa-times"></i></button>
        </div>
      </div>
      <form id="bank-form" class="p-5">
        <input type="hidden" id="bank-id">
        <div class="grid-2">
          <div class="settings-form-group">
            <label for="bank_name" class="settings-label">Bank Name <span class="required">*</span></label>
            <input type="text" id="bank_name" class="settings-input" required>
          </div>
          <div class="settings-form-group">
            <label for="account_holder" class="settings-label">Account Holder <span class="required">*</span></label>
            <input type="text" id="account_holder" class="settings-input" required>
          </div>
        </div>
        <div class="grid-2">
          <div class="settings-form-group">
            <label for="account_number" class="settings-label">Account Number <span class="required">*</span></label>
            <input type="text" id="account_number" class="settings-input" required>
          </div>
          <div class="settings-form-group">
            <label for="ifsc_code" class="settings-label">IFSC Code <span class="required">*</span></label>
            <input type="text" id="ifsc_code" class="settings-input" required>
          </div>
        </div>
        <div class="grid-2">
          <div class="settings-form-group">
            <label for="branch_name" class="settings-label">Branch</label>
            <input type="text" id="branch_name" class="settings-input">
          </div>
          <div class="settings-form-group">
            <label for="account_type" class="settings-label">Account Type</label>
            <select id="account_type" class="settings-input">
              <option value="">Select</option>
              <option value="Savings">Savings</option>
              <option value="Current">Current</option>
            </select>
          </div>
        </div>
        <div class="settings-form-group">
          <label for="upi_id" class="settings-label">UPI ID</label>
          <input type="text" id="upi_id" class="settings-input" placeholder="yourname@paytm">
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t" style="border-color:var(--gray-200);">
          <button type="button" id="cancel-bank-btn" class="btn btn-secondary" style="width:auto;">Cancel</button>
          <button type="submit" id="save-bank-btn" class="btn btn-primary" style="width:auto;min-width:120px;">Save
            Bank</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="delete-modal" class="settings-modal">
    <div class="settings-modal-overlay" id="delete-modal-overlay"></div>
    <div class="settings-modal-content" style="max-width:400px;">
      <div class="p-6 text-center">
        <div class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4"
          style="background:rgba(239,68,68,0.1);"><i class="fas fa-exclamation-triangle text-danger text-xl"></i></div>
        <h3 class="text-lg font-semibold mb-2" id="delete-modal-title">Delete</h3>
        <p class="text-sm text-muted mb-6" id="delete-modal-message">Are you sure?</p>
        <div class="flex gap-3">
          <button id="cancel-delete-btn" class="btn btn-secondary flex-1">Cancel</button>
          <button id="confirm-delete-btn" class="btn btn-danger flex-1">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT -->
  <!-- Global Theme Manager -->
  <script src="../js/theme-manager.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const API_BASE = 'https://api.fornowauto.com/api';
      let companyId = null, businessLogoBase64 = null, currentBankId = null, deleteTarget = null;
      const countries = [{ code: "IN", name: "India" }, { code: "US", name: "United States" }, { code: "GB", name: "United Kingdom" }, { code: "CA", name: "Canada" }, { code: "AU", name: "Australia" }, { code: "AE", name: "UAE" }, { code: "SG", name: "Singapore" }];

      const getEl = id => document.getElementById(id);
      const getToken = () => localStorage.getItem('token') || localStorage.getItem('auth_token');
      const getUserId = () => localStorage.getItem('userId');

      function showToast(msg, type = 'success') {
        const toast = getEl('toast'), toastMsg = getEl('toast-message');
        toastMsg.textContent = msg;
        toast.className = `toast toast-${type} show`;
        setTimeout(() => toast.classList.remove('show'), 3000);
      }

      function setLoading(btn, loading) {
        if (loading) { btn.dataset.originalText = btn.innerHTML; btn.innerHTML = '<div class="btn-spinner"></div>'; btn.disabled = true; }
        else { btn.innerHTML = btn.dataset.originalText || 'Submit'; btn.disabled = false; }
      }

      function populateCountries() {
        [getEl('personal_country'), getEl('business_country')].forEach(sel => {
          if (!sel) return;
          sel.innerHTML = '<option value="">Select Country</option>';
          countries.forEach(c => { const o = document.createElement('option'); o.value = c.code; o.textContent = c.name; sel.appendChild(o); });
        });
      }

      // TABS
      document.querySelectorAll('.tab-button').forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          document.querySelectorAll('.tab-button').forEach(b => { b.classList.remove('tab-active'); b.classList.add('tab-inactive'); });
          btn.classList.remove('tab-inactive'); btn.classList.add('tab-active');
          document.querySelectorAll('.tab-content').forEach(c => { c.id === `tab-${tab}` ? c.classList.remove('hidden') : c.classList.add('hidden'); });
          if (tab === 'bank') loadBanks();
        });
      });

      // MOBILE SIDEBAR
      const menuToggle = getEl('menu-toggle'), sidebar = getEl('sidebar'), backdrop = getEl('menu-backdrop');
      menuToggle?.addEventListener('click', () => { sidebar.classList.toggle('collapsed'); backdrop.classList.toggle('active'); });
      backdrop?.addEventListener('click', () => { sidebar.classList.add('collapsed'); backdrop.classList.remove('active'); });

      // LOAD PROFILE - Get user data from localStorage first, then try API
      async function loadProfile() {
        try {
          const token = getToken(), userId = getUserId();
          const storedEmail = localStorage.getItem('email') || '';
          const storedPhone = localStorage.getItem('phone') || '';

          // Set from localStorage first
          if (storedEmail) getEl('email').value = storedEmail;
          if (storedPhone) getEl('phone').value = storedPhone;

          if (!token || !userId) {
            console.log('No token or userId, using localStorage data');
            return;
          }

          // Try to fetch from API
          const res = await fetch(`${API_BASE}/register/${userId}`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });

          if (!res.ok) {
            console.log('Profile API returned:', res.status);
            // If API fails, try to get data from companies API
            return;
          }

          const data = await res.json();
          const user = Array.isArray(data) ? data[0] : data;

          if (user) {
            getEl('fullName').value = user.username || '';
            getEl('email').value = user.email || storedEmail || '';
            getEl('phone').value = user.phone || storedPhone || '';
            getEl('sidebar-name').textContent = user.username || 'User';
            getEl('sidebar-email').textContent = user.email || storedEmail || '';
            if (user.country) {
              const c = countries.find(x => x.name === user.country);
              if (c) getEl('personal_country').value = c.code;
            }
          }
        } catch (e) {
          console.error('Profile load error:', e);
          // Still use localStorage data on error
          const storedEmail = localStorage.getItem('email') || '';
          if (storedEmail) {
            getEl('email').value = storedEmail;
            getEl('sidebar-email').textContent = storedEmail;
          }
        }
      }

      // LOAD BUSINESS
      async function loadBusiness() {
        try {
          const token = getToken();
          if (!token) return;
          const res = await fetch(`${API_BASE}/companies`, { headers: { 'Authorization': `Bearer ${token}` } });
          if (!res.ok) return;
          const companies = await res.json();
          if (!companies.length) return;
          const data = companies[0];
          companyId = data._id;
          getEl('businessName').value = data.company_name || '';
          getEl('website').value = data.website || '';
          getEl('business_phone').value = data.phone || '';
          getEl('business_email').value = data.email || '';
          getEl('gst').value = data.gst_no || '';
          getEl('currency').value = data.currency || '';
          const ts = parseInt(data.team_size) || 0;
          if (ts >= 11) getEl('teamSize').value = '11';
          else if (ts >= 6) getEl('teamSize').value = '6';
          else if (ts >= 2) getEl('teamSize').value = '2';
          else if (ts === 1) getEl('teamSize').value = '1';
          if (data.logo) { getEl('business-logo-preview').src = data.logo; businessLogoBase64 = data.logo; getEl('sidebar-avatar').src = data.logo; }
          if (data.address) {
            getEl('street').value = data.address.street || '';
            getEl('city').value = data.address.city || '';
            getEl('state').value = data.address.state || '';
            getEl('pincode').value = data.address.postalCode || '';
            const c = countries.find(x => x.name === data.address.country);
            if (c) getEl('business_country').value = c.code;
          }

          // Also populate Profile tab fields from company data if empty
          if (data.company_name && !getEl('fullName').value) {
            getEl('fullName').value = data.company_name;
          }
          if (data.email && !getEl('email').value) {
            getEl('email').value = data.email;
          }
          if (data.phone && !getEl('phone').value) {
            getEl('phone').value = data.phone;
          }

          // Update sidebar
          if (data.company_name) getEl('sidebar-name').textContent = data.company_name;
          if (data.email) getEl('sidebar-email').textContent = data.email;
        } catch (e) { console.error('Business load error:', e); }
      }

      // SAVE PROFILE
      getEl('profile-form').addEventListener('submit', async e => {
        e.preventDefault();
        const btn = getEl('save-profile-btn');
        setLoading(btn, true);
        try {
          const token = getToken(), userId = getUserId();
          if (!token || !userId) throw new Error('Not authenticated');

          const profileData = {
            username: getEl('fullName').value,
            email: getEl('email').value,
            phone: getEl('phone').value
          };

          // Save to localStorage as backup
          localStorage.setItem('email', profileData.email);
          localStorage.setItem('phone', profileData.phone);

          const res = await fetch(`${API_BASE}/register/${userId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify(profileData)
          });

          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.message || `Server error: ${res.status}`);
          }

          showToast('Profile updated!');

          // Update sidebar
          getEl('sidebar-name').textContent = profileData.username || 'User';
          getEl('sidebar-email').textContent = profileData.email;

        } catch (e) {
          console.error('Profile save error:', e);
          showToast(e.message || 'Failed to save profile', 'error');
        }
        finally { setLoading(btn, false); }
      });

      // LOGO UPLOAD
      getEl('logo').addEventListener('change', function () {
        if (this.files && this.files[0]) {
          const reader = new FileReader();
          reader.onload = e => { businessLogoBase64 = e.target.result; getEl('business-logo-preview').src = businessLogoBase64; };
          reader.readAsDataURL(this.files[0]);
        }
      });

      // SAVE BUSINESS
      getEl('business-form').addEventListener('submit', async e => {
        e.preventDefault();
        const btn = getEl('save-business-btn');
        setLoading(btn, true);
        try {
          const token = getToken(), userId = getUserId();
          if (!token || !userId || !companyId) throw new Error('Cannot update');
          const countryName = countries.find(c => c.code === getEl('business_country').value)?.name || '';
          const payload = {
            company_name: getEl('businessName').value, team_size: getEl('teamSize').value, website: getEl('website').value,
            phone: getEl('business_phone').value, email: getEl('business_email').value, gst_no: getEl('gst').value,
            currency: getEl('currency').value, logo: businessLogoBase64,
            address: { street: getEl('street').value, city: getEl('city').value, state: getEl('state').value, postalCode: getEl('pincode').value, country: countryName }
          };
          const res = await fetch(`${API_BASE}/companies/${companyId}?user_id=${userId}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }, body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('Failed');
          showToast('Business updated!');
          loadBusiness();
        } catch (e) { showToast(e.message, 'error'); }
        finally { setLoading(btn, false); }
      });

      // BANK MANAGEMENT
      const bankModal = getEl('bank-modal');
      function openBankModal(isEdit = false, data = null) {
        currentBankId = data?._id || null;
        getEl('bank-modal-title').textContent = isEdit ? 'Edit Bank' : 'Add Bank';
        if (isEdit && data) {
          getEl('bank-id').value = data._id || '';
          getEl('bank_name').value = data.bank_name || '';
          getEl('account_holder').value = data.account_holder || '';
          getEl('account_number').value = data.account_number || '';
          getEl('ifsc_code').value = data.ifsc_code || '';
          getEl('branch_name').value = data.branch_name || '';
          getEl('account_type').value = data.account_type || '';
          getEl('upi_id').value = data.upi_id || '';
        } else { getEl('bank-form').reset(); }
        bankModal.classList.add('active');
      }
      function closeBankModal() { bankModal.classList.remove('active'); getEl('bank-form').reset(); currentBankId = null; }
      getEl('add-bank-btn').addEventListener('click', () => openBankModal(false));
      getEl('close-bank-modal').addEventListener('click', closeBankModal);
      getEl('cancel-bank-btn').addEventListener('click', closeBankModal);
      getEl('bank-modal-overlay').addEventListener('click', closeBankModal);

      async function loadBanks() {
        try {
          const token = getToken();
          if (!token) return;
          const res = await fetch(`${API_BASE}/banks`, { headers: { 'Authorization': `Bearer ${token}` } });
          if (!res.ok) { getEl('banks-list').innerHTML = '<div class="empty-state"><i class="fas fa-university empty-state-icon"></i><p class="empty-state-title">No bank accounts</p></div>'; return; }
          const banks = await res.json();
          if (!banks.length) { getEl('banks-list').innerHTML = '<div class="empty-state"><i class="fas fa-university empty-state-icon"></i><p class="empty-state-title">No bank accounts</p></div>'; return; }
          getEl('banks-list').innerHTML = banks.map(b => `
          <div class="bank-card">
            <div class="flex justify-between items-start">
              <div><div class="flex items-center gap-2 mb-2"><i class="fas fa-university text-primary"></i><h3 class="font-semibold">${b.bank_name || 'N/A'}</h3></div>
              <div class="grid-2 text-sm"><p><span class="text-muted">Holder:</span> ${b.account_holder || 'N/A'}</p><p><span class="text-muted">A/C:</span> ****${(b.account_number || '').slice(-4)}</p><p><span class="text-muted">IFSC:</span> ${b.ifsc_code || 'N/A'}</p><p><span class="text-muted">Branch:</span> ${b.branch_name || 'N/A'}</p></div></div>
              <div class="flex gap-2"><button class="btn btn-ghost edit-bank-btn" style="width:auto;padding:0.5rem;" data-bank='${JSON.stringify(b)}'><i class="fas fa-edit text-primary"></i></button><button class="btn btn-ghost delete-bank-btn" style="width:auto;padding:0.5rem;" data-id="${b._id}"><i class="fas fa-trash text-danger"></i></button></div>
            </div>
          </div>
        `).join('');
          document.querySelectorAll('.edit-bank-btn').forEach(btn => btn.addEventListener('click', () => openBankModal(true, JSON.parse(btn.dataset.bank))));
          document.querySelectorAll('.delete-bank-btn').forEach(btn => btn.addEventListener('click', () => { deleteTarget = btn.dataset.id; getEl('delete-modal-title').textContent = 'Delete Bank'; getEl('delete-modal-message').textContent = 'Delete this bank account?'; getEl('delete-modal').classList.add('active'); }));
        } catch (e) { console.error(e); }
      }

      getEl('bank-form').addEventListener('submit', async e => {
        e.preventDefault();
        const btn = getEl('save-bank-btn');
        setLoading(btn, true);
        try {
          const token = getToken();
          if (!token) throw new Error('Not authenticated');
          const payload = { bank_name: getEl('bank_name').value, account_holder: getEl('account_holder').value, account_number: getEl('account_number').value, ifsc_code: getEl('ifsc_code').value.toUpperCase(), branch_name: getEl('branch_name').value, account_type: getEl('account_type').value, upi_id: getEl('upi_id').value };
          const isEdit = !!currentBankId;
          const res = await fetch(isEdit ? `${API_BASE}/banks/${currentBankId}` : `${API_BASE}/banks`, {
            method: isEdit ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }, body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('Failed');
          showToast(isEdit ? 'Bank updated!' : 'Bank added!');
          closeBankModal();
          loadBanks();
        } catch (e) { showToast(e.message, 'error'); }
        finally { setLoading(btn, false); }
      });

      // DELETE MODAL
      const deleteModal = getEl('delete-modal');
      getEl('cancel-delete-btn').addEventListener('click', () => { deleteModal.classList.remove('active'); deleteTarget = null; });
      getEl('delete-modal-overlay').addEventListener('click', () => { deleteModal.classList.remove('active'); deleteTarget = null; });
      getEl('confirm-delete-btn').addEventListener('click', async () => {
        if (!deleteTarget) return;
        const btn = getEl('confirm-delete-btn');
        setLoading(btn, true);
        try {
          const token = getToken();
          if (deleteTarget === 'account') {
            const res = await fetch(`${API_BASE}/register/schedule-deletion/${getUserId()}`, { method: 'PATCH', headers: { 'Authorization': `Bearer ${token}` } });
            if (!res.ok) throw new Error('Failed');
            showToast('Account scheduled for deletion');
            setTimeout(() => { localStorage.clear(); window.location.href = 'index.html'; }, 2000);
          } else {
            const res = await fetch(`${API_BASE}/banks/${deleteTarget}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
            if (!res.ok) throw new Error('Failed');
            showToast('Bank deleted!');
            loadBanks();
          }
          deleteModal.classList.remove('active');
          deleteTarget = null;
        } catch (e) { showToast(e.message, 'error'); }
        finally { setLoading(btn, false); }
      });
      getEl('delete-account-btn').addEventListener('click', () => { deleteTarget = 'account'; getEl('delete-modal-title').textContent = 'Delete Account'; getEl('delete-modal-message').textContent = 'Your account will be deleted after 30 days.'; deleteModal.classList.add('active'); });

      // PASSWORD
      getEl('verify-password-btn').addEventListener('click', async () => {
        const btn = getEl('verify-password-btn'), pwd = getEl('currentPassword').value;
        if (!pwd) { showToast('Enter password', 'error'); return; }
        setLoading(btn, true);
        try {
          const res = await fetch(`${API_BASE}/register/${getUserId()}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${getToken()}` }, body: JSON.stringify({ password: pwd }) });
          if (!res.ok) throw new Error('Incorrect');
          showToast('Verified!');
          getEl('currentPassword').disabled = true;
          btn.classList.add('hidden');
          getEl('new-password-section').classList.remove('hidden');
        } catch (e) { showToast(e.message, 'error'); }
        finally { setLoading(btn, false); }
      });

      getEl('password-form').addEventListener('submit', async e => {
        e.preventDefault();
        const newP = getEl('newPassword').value, confP = getEl('confirmPassword').value;
        if (newP !== confP) { showToast('Passwords do not match', 'error'); return; }
        const btn = getEl('update-password-btn');
        setLoading(btn, true);
        try {
          const res = await fetch(`${API_BASE}/register/${getUserId()}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${getToken()}` }, body: JSON.stringify({ password: newP }) });
          if (!res.ok) throw new Error('Failed');
          showToast('Password updated!');
          getEl('password-form').reset();
          getEl('currentPassword').disabled = false;
          getEl('verify-password-btn').classList.remove('hidden');
          getEl('new-password-section').classList.add('hidden');
        } catch (e) { showToast(e.message, 'error'); }
        finally { setLoading(btn, false); }
      });

      // NOTIFICATIONS
      ['email-notifications', 'order-alerts', 'weekly-summary'].forEach(id => {
        const tog = getEl(id);
        if (!tog) return;
        tog.checked = localStorage.getItem(`qsi-${id}`) === 'true';
        tog.addEventListener('change', e => { localStorage.setItem(`qsi-${id}`, e.target.checked); showToast(`${id.replace(/-/g, ' ')} ${e.target.checked ? 'enabled' : 'disabled'}`); });
      });

      // THEME - Using Global Theme Manager
      const themeOptions = document.querySelectorAll('.theme-option');

      function setSelectedTheme(theme) {
        themeOptions.forEach(o => o.classList.toggle('selected', o.dataset.theme === theme));
      }

      // Get current theme from global manager
      const savedTheme = window.QSITheme.get();
      setSelectedTheme(savedTheme);

      // Handle theme option clicks
      themeOptions.forEach(o => o.addEventListener('click', () => {
        const selectedTheme = o.dataset.theme;

        // Use global theme manager to set theme
        window.QSITheme.set(selectedTheme);

        // Update UI
        setSelectedTheme(selectedTheme);

        // Show confirmation
        const themeLabel = selectedTheme.charAt(0).toUpperCase() + selectedTheme.slice(1);
        showToast(`Theme changed to ${themeLabel}. This will apply to all pages.`);
      }));

      // INIT
      populateCountries();
      loadProfile();
      loadBusiness();
    });
  </script>
</body>

</html>