<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payouts - QSI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f9fafb;
    }

    .sidebar-link.active {
      background-color: #4f46e5;
      color: white;
    }

    .sidebar-link.active .icon,
    .sidebar-link.active .text {
      color: white;
    }

    @media (max-width: 768px) {
      #main-content {
        margin-top: 64px;
      }
    }
  </style>
    <link rel="stylesheet" href="../js/theme-overrides.css">
    <!-- Global Theme Manager -->
    <script src="../js/theme-manager.js"></script>
</head>

<body class="bg-gray-50">
  <div class="flex">
    <!-- Left Sidebar Navigation -->
    <header
      class="bg-gray-800 text-white flex items-center justify-between p-4 md:hidden fixed top-0 left-0 w-full z-50 shadow-md">
      <div class="flex items-center space-x-3">
        <button id="menu-toggle" class="text-white focus:outline-none">
          <i class="fas fa-bars text-2xl"></i>
        </button>
        <span class="text-xl font-bold">QSI</span>
      </div>
      <div class="flex items-center space-x-2">
        <button id="mobile-avatar-btn" title="Account" class="p-0 bg-transparent border-0">
          <img id="mobile-avatar-img" src="https://placehold.co/40x40/E2E8F0/4A5568?text=U" alt="Business Logo"
            class="w-8 h-8 rounded-full">
        </button>
      </div>
    </header>

    <!-- BACKDROP for mobile -->
    <div id="menu-backdrop" class="fixed inset-0 bg-black bg-opacity-50 hidden md:hidden z-40"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar"
      class="w-64 bg-gray-800 text-white h-screen fixed md:sticky top-0 left-0 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50 flex flex-col shadow-lg">
      <div class="p-6 text-2xl font-bold border-b border-gray-700">
        <i class=" mr-2 text-indigo-400"></i> QSI
      </div>
      <nav class="flex-1 p-4 space-y-2">
        <a href="dashboard_with_login.html"
          class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          <i class="fas fa-chart-pie mr-3"></i>Dashboard
        </a>
        <div>
          <button id="documents-dropdown-btn"
            class="w-full flex justify-between items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 text-left">
            <span class="flex items-center"><i class="fas fa-file-invoice mr-3"></i>Sales Documents</span>
            <i id="dropdown-icon" class="fas fa-chevron-down transform transition-transform duration-200"></i>
          </button>
          <div id="documents-dropdown-content" class="pl-8 pt-2 space-y-1 hidden">
            <a href="quotation/home_quotation.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Quotation</a>
            <a href="saleorder/home_sales_order.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Sales
              Order</a>
            <a href="invoice/home_invoice.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Invoice</a>
            <a href="credit_note.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Credit
              note</a>
          </div>
        </div>
        <div>
          <button id="purchases-dropdown-btn"
            class="w-full flex justify-between items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 text-left">
            <span class="flex items-center"><i class="fas fa-shopping-cart mr-3"></i>Purchases</span>
            <i id="purchases-dropdown-icon" class="fas fa-chevron-down transform transition-transform duration-200"></i>
          </button>
          <div id="purchases-dropdown-content" class="pl-8 pt-2 space-y-1 hidden">
            <a href="parchase/vendor/vendors_leads.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Vendors
              Leads</a>
            <a href="parchase/parchase_order/home_purchase_orders.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Purchase
              Orders</a>
            <a href="parchase/debit notes/debit_notes.html"
              class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Debit
              Notes</a>
          </div>
        </div>
        <a href="manage-clients.html"
          class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          <i class="fas fa-users mr-3"></i>Manage Clients
        </a>
        <a href="payout.html"
          class="flex items-center py-2.5 px-4 rounded transition duration-200 bg-gray-700 text-white">
          <i class="fas fa-money-bill-wave mr-3"></i>Payouts
        </a>
        <a href="settings.html" class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
          <i class="fas fa-cog mr-3"></i>Settings
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="flex-1" id="main-content">
      <!-- Top Header -->
      <header class="bg-white shadow-sm p-4 flex justify-between items-center hidden md:flex">
        <h1 class="text-2xl font-semibold text-gray-800">Payouts</h1>
        <div class="flex items-center space-x-4">
          <p id="live-datetime" class="text-sm text-gray-600 font-medium"></p>
          <div class="flex items-center space-x-2">
            <button id="business-avatar-btn" title="Account" class="p-0 bg-transparent border-0">
              <img id="business-avatar-img" src="https://placehold.co/40x40/E2E8F0/4A5568?text=U" alt="Business Logo"
                class="w-8 h-8 rounded-full">
            </button>
          </div>
        </div>
      </header>

      <main class="p-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
          <div>
            <h2 class="text-3xl font-bold text-gray-900">Payouts</h2>
            <p class="text-gray-600 mt-1">Manage your earnings and withdrawals.</p>
          </div>
          <button onclick="document.getElementById('payout-modal').classList.remove('hidden')"
            class="bg-indigo-600 text-white px-6 py-2.5 rounded-lg hover:bg-indigo-700 transition shadow-sm flex items-center">
            <i class="fas fa-plus mr-2"></i> Request Payout
          </button>
        </div>

        <!-- Balance Card -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Available Balance</h3>
            <div class="mt-2 flex items-baseline">
              <span class="text-4xl font-extrabold text-gray-900">$0.00</span>
              <span class="ml-2 text-sm text-gray-500">USD</span>
            </div>
            <p class="text-sm text-green-600 mt-2 flex items-center">
              <i class="fas fa-arrow-up mr-1"></i> +$0.00 this month
            </p>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Pending Payouts</h3>
            <div class="mt-2 flex items-baseline">
              <span class="text-4xl font-extrabold text-gray-900">$0.00</span>
              <span class="ml-2 text-sm text-gray-500">USD</span>
            </div>
            <p class="text-sm text-gray-500 mt-2">No pending requests</p>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-gray-500 text-sm font-medium uppercase tracking-wider">Total Withdrawn</h3>
            <div class="mt-2 flex items-baseline">
              <span class="text-4xl font-extrabold text-gray-900">$0.00</span>
              <span class="ml-2 text-sm text-gray-500">USD</span>
            </div>
            <p class="text-sm text-gray-500 mt-2">Lifetime earnings</p>
          </div>
        </div>

        <!-- Payout History -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800">Payout History</h3>
            <button id="view-all-btn" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">View
              All</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-gray-900 font-medium border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3">Date</th>
                  <th class="px-6 py-3">Transaction ID</th>
                  <th class="px-6 py-3">Amount</th>
                  <th class="px-6 py-3">Method</th>
                  <th class="px-6 py-3">Status</th>
                  <th class="px-6 py-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
              </tbody>
            </table>
          </div>
          <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex justify-between items-center">
            <span id="pagination-info" class="text-sm text-gray-500">Showing 0 transactions</span>
            <div class="flex space-x-2">
              <button id="prev-page-btn"
                class="px-3 py-1 border border-gray-300 rounded bg-white text-sm text-gray-600 hover:bg-gray-50 disabled:opacity-50"
                disabled>Previous</button>
              <button id="next-page-btn"
                class="px-3 py-1 border border-gray-300 rounded bg-white text-sm text-gray-600 hover:bg-gray-50">Next</button>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Payout Request Modal -->
  <div id="payout-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3 text-center">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Request Payout</h3>
        <div class="mt-2 px-7 py-3">
          <p class="text-sm text-gray-500">Enter the amount you wish to withdraw and your preferred method.
          </p>
          <div class="mt-4">
            <label for="amount" class="block text-sm font-medium text-gray-700 text-left">Amount</label>
            <input type="number" id="amount" name="amount" min="0.01" step="0.01"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              placeholder="0.00">
          </div>
          <div class="mt-4">
            <label for="payout-method" class="block text-sm font-medium text-gray-700 text-left">Payout
              Method</label>
            <select id="payout-method" name="payout-method"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              <option value="bank_transfer">Bank Transfer</option>
              <option value="paypal">PayPal</option>
              <option value="stripe">Stripe</option>
            </select>
          </div>
          <div class="mt-4">
            <label for="payout-notes" class="block text-sm font-medium text-gray-700 text-left">Notes
              (Optional)</label>
            <textarea id="payout-notes" name="payout-notes" rows="3"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
              placeholder="Any specific instructions..."></textarea>
          </div>
        </div>
        <div class="items-center px-4 py-3">
          <button id="submit-payout-btn"
            class="px-4 py-2 bg-indigo-600 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            Submit Payout Request
          </button>
          <button onclick="document.getElementById('payout-modal').classList.add('hidden')"
            class="mt-3 px-4 py-2 bg-gray-200 text-gray-800 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Logout Confirmation Modal -->
  <div id="logout-confirm-modal"
    class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full items-center justify-center">
    <div class="relative p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3 text-center">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Confirm Logout</h3>
        <div class="mt-2 px-7 py-3">
          <p class="text-sm text-gray-500">Are you sure you want to log out?</p>
        </div>
        <div class="items-center px-4 py-3">
          <button id="confirm-ok"
            class="px-4 py-2 bg-red-600 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
            Log Out
          </button>
          <button id="confirm-cancel"
            class="mt-3 px-4 py-2 bg-gray-200 text-gray-800 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Logout Popover -->
  <div id="logout-modal"
    class="hidden absolute right-4 top-16 w-48 bg-white rounded-md shadow-lg py-1 z-50 ring-1 ring-black ring-opacity-5">
    <div class="px-4 py-2 border-b border-gray-100">
      <p id="modal-business-name" class="text-sm font-medium text-gray-900">Business Name</p>
      <p id="modal-business-email" class="text-xs text-gray-500 truncate">email@example.com</p>
    </div>
    <a href="settings.html" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
    <a href="#" id="logout-confirm" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-100">Log out</a>
  </div>

            <script>
              // API Base URL (replace with your actual API endpoint)
              const API_BASE_URL = 'https://api.fornowauto.com/api';

              // Generic fetch function with error handling
              async function fetchAPI(url, options = {}) {
                try {
                  const token = localStorage.getItem('auth_token'); // Or your actual token key
                  const headers = {
                    'Content-Type': 'application/json',
                    ...options.headers
                  };
                  if (token) {
                    headers['Authorization'] = `Bearer ${token}`;
                  }

                  const response = await fetch(url, {
                    ...options,
                    headers
                  });

                  if (response.status === 401) {
                    localStorage.removeItem('token');
                    localStorage.removeItem('auth_token');
                    window.location.href = '../index.html';
                    throw new Error("Session expired");
                  }

                  if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                  }

                  return await response.json();
                } catch (error) {
                  console.error('API fetch error:', error);
                  throw error;
                }
              }

              // --- Sidebar toggle ---
              const sidebar = document.getElementById('sidebar');
              const sidebarToggle = document.getElementById('menu-toggle');
              const backdrop = document.getElementById('menu-backdrop');

              if (sidebarToggle) {
                sidebarToggle.addEventListener('click', () => {
                  sidebar.classList.remove('-translate-x-full');
                  if (backdrop) backdrop.classList.remove('hidden');
                });
              }

              if (backdrop) {
                backdrop.addEventListener('click', () => {
                  sidebar.classList.add('-translate-x-full');
                  backdrop.classList.add('hidden');
                });
              }

              // --- Top-right business name population and logout modal ---
              (function () {
                const avatarBtn = document.getElementById('business-avatar-btn');
                const mobileAvatarBtn = document.getElementById('mobile-avatar-btn');
                const avatarImg = document.getElementById('business-avatar-img');
                const mobileAvatarImg = document.getElementById('mobile-avatar-img');
                const modalLogo = document.getElementById('modal-business-logo');
                const modalNameEl = document.getElementById('modal-business-name');
                const modalEmailEl = document.getElementById('modal-business-email');
                const logoutModal = document.getElementById('logout-modal');
                const logoutConfirm = document.getElementById('logout-confirm');
                const logoutConfirmModal = document.getElementById('logout-confirm-modal');
                const confirmCancel = document.getElementById('confirm-cancel');
                const confirmOk = document.getElementById('confirm-ok');

                // Pagination state
                let allOrders = [];
                let currentPage = 1;
                let itemsPerPage = 10;

                async function fetchCompanyDetails() {
                  try {
                    const data = await fetchAPI(`${API_BASE_URL}/companies`);
                    const list = Array.isArray(data) ? data : (data.data || data.companies || []);
                    if (list && list[0]) {
                      const comp = list[0];
                      const name = comp.company_name || comp.business_name || comp.name || 'Business';
                      const logo = comp.logo || '';
                      const email = comp.email || comp.contact_email || '';
                      // set avatar image and modal details
                      if (logo) {
                        if (avatarImg) avatarImg.src = logo;
                        if (mobileAvatarImg) mobileAvatarImg.src = logo;
                        if (modalLogo) modalLogo.src = logo;
                      }
                      if (modalNameEl) modalNameEl.textContent = name;
                      if (modalEmailEl) modalEmailEl.textContent = email || '';
                    }
                  } catch (e) {
                    console.warn('Could not fetch company details', e);
                  }
                }

                async function fetchPayouts() {
                  try {
                    const data = await fetchAPI(`${API_BASE_URL}/payouts`);
                    allOrders = Array.isArray(data) ? data : (data.data || []);
                    currentPage = 1;
                    renderPage(currentPage);
                  } catch (e) {
                    console.warn('Error fetching payouts:', e);
                    renderPayoutHistory([]); 
                  }
                }

                function renderPage(page) {
                  const start = (page - 1) * itemsPerPage;
                  const end = start + itemsPerPage;
                  const paginatedOrders = allOrders.slice(start, end);
                  renderPayoutHistory(paginatedOrders);
                  updatePaginationControls();
                }

                function updatePaginationControls() {
                  const paginationInfo = document.getElementById('pagination-info');
                  const prevBtn = document.getElementById('prev-page-btn');
                  const nextBtn = document.getElementById('next-page-btn');

                  if (paginationInfo) {
                    if (allOrders.length === 0) {
                      paginationInfo.textContent = 'Showing 0 transactions';
                    } else {
                      const start = (currentPage - 1) * itemsPerPage + 1;
                      const end = Math.min(currentPage * itemsPerPage, allOrders.length);
                      paginationInfo.textContent = `Showing ${start}-${end} of ${allOrders.length} transactions`;
                    }
                  }

                  if (prevBtn) {
                    prevBtn.disabled = currentPage === 1;
                  }

                  if (nextBtn) {
                    const totalPages = Math.ceil(allOrders.length / itemsPerPage);
                    nextBtn.disabled = currentPage >= totalPages || allOrders.length === 0;
                    if (nextBtn.disabled) {
                      nextBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    } else {
                      nextBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }
                  }
                }

                function renderPayoutHistory(orders) {
                  const tbody = document.querySelector('tbody');
                  if (!tbody) return;
                  tbody.innerHTML = '';

                  if (orders.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">No transactions found</td></tr>';
                    return;
                  }

                  orders.forEach(order => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-gray-50 transition';
                    
                    const date = order.created_at ? new Date(order.created_at).toLocaleDateString() : (order.date || order.po_date || '-');
                    const id = order.id || order.payout_id || order.po_no || '-';
                    const amount = order.amount || order.total;
                    const method = order.method || order.payout_method || order.vendor_name || 'Bank Transfer';
                    let status = order.status || 'Pending';
                    
                    let statusClass = 'bg-yellow-100 text-yellow-800 border-yellow-200';
                    if (status.toLowerCase() === 'completed' || status.toLowerCase() === 'paid') {
                      statusClass = 'bg-green-100 text-green-800 border-green-200';
                    } else if (status.toLowerCase() === 'failed' || status.toLowerCase() === 'rejected') {
                      statusClass = 'bg-red-100 text-red-800 border-red-200';
                    }

                    tr.innerHTML = `
                      <td class="px-6 py-4">${date}</td>
                      <td class="px-6 py-4 font-mono text-xs">${id}</td>
                      <td class="px-6 py-4 font-medium text-gray-900">${amount ? 'â‚¹' + amount : '-'}</td>
                      <td class="px-6 py-4 flex items-center">
                        <i class="fas fa-university text-gray-400 mr-2"></i> ${method}
                      </td>
                      <td class="px-6 py-4">
                        <span class="${statusClass} px-2.5 py-0.5 rounded-full text-xs font-semibold border">${status}</span>
                      </td>
                      <td class="px-6 py-4 text-right">
                        <button class="text-gray-400 hover:text-gray-600"><i class="fas fa-ellipsis-v"></i></button>
                      </td>
                    `;
                    tbody.appendChild(tr);
                  });
                }

                // Toggle popover panel on avatar click
                if (avatarBtn) {
                  avatarBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    logoutModal.classList.toggle('hidden');
                  });
                }
                if (mobileAvatarBtn) {
                  mobileAvatarBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    logoutModal.classList.toggle('hidden');
                  });
                }

                // Hide popover if click outside
                document.addEventListener('mousedown', (event) => {
                  if (!logoutModal.classList.contains('hidden')) {
                    if (!logoutModal.contains(event.target) && event.target !== avatarBtn && (!mobileAvatarBtn || event.target !== mobileAvatarBtn) && !avatarBtn.contains(event.target)) {
                      logoutModal.classList.add('hidden');
                    }
                  }
                });

                // When user clicks Log out in the bottom sheet, show confirmation modal
                if (logoutConfirm) {
                  logoutConfirm.addEventListener('click', (e) => {
                    e.preventDefault();
                    logoutModal.classList.add('hidden');
                    logoutConfirmModal.classList.remove('hidden');
                    logoutConfirmModal.classList.add('flex');
                  });
                }

                // Cancel the centered confirmation
                if (confirmCancel) {
                  confirmCancel.addEventListener('click', () => {
                    logoutConfirmModal.classList.add('hidden');
                    logoutConfirmModal.classList.remove('flex');
                  });
                }

                // Final OK - perform logout
                if (confirmOk) {
                  confirmOk.addEventListener('click', () => {
                    localStorage.removeItem('auth_token');
                    localStorage.removeItem('auth_scheme');
                    localStorage.removeItem('token');
                    localStorage.removeItem('userId');
                    window.location.href = '../index.html';
                  });
                }

                // Live datetime update
                function updateDateTime() {
                  const el = document.getElementById('live-datetime');
                  if (!el) return;
                  const d = new Date();
                  const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                  const datePart = d.toLocaleDateString(undefined, options);
                  const timePart = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                  el.textContent = `${datePart} ${timePart}`;
                }
                updateDateTime();
                setInterval(updateDateTime, 1000);

                // Pagination Event Listeners
                const prevBtn = document.getElementById('prev-page-btn');
                const nextBtn = document.getElementById('next-page-btn');
                const viewAllBtn = document.getElementById('view-all-btn');

                if (prevBtn) {
                  prevBtn.addEventListener('click', () => {
                    if (currentPage > 1) {
                      currentPage--;
                      renderPage(currentPage);
                    }
                  });
                }

                if (nextBtn) {
                  nextBtn.addEventListener('click', () => {
                    const totalPages = Math.ceil(allOrders.length / itemsPerPage);
                    if (currentPage < totalPages) {
                      currentPage++;
                      renderPage(currentPage);
                    }
                  });
                }

                if (viewAllBtn) {
                  viewAllBtn.addEventListener('click', () => {
                    itemsPerPage = allOrders.length;
                    currentPage = 1;
                    renderPage(1);
                    if (prevBtn) prevBtn.style.display = 'none';
                    if (nextBtn) nextBtn.style.display = 'none';
                  });
                }

                // Handle Payout Submission
                const submitPayoutBtn = document.getElementById('submit-payout-btn');
                if (submitPayoutBtn) {
                  submitPayoutBtn.addEventListener('click', async () => {
                    const amountInput = document.getElementById('amount');
                    const methodInput = document.getElementById('payout-method');
                    const notesInput = document.getElementById('payout-notes');

                    const amount = amountInput.value;
                    const method = methodInput ? methodInput.value : '';
                    const notes = notesInput ? notesInput.value : '';

                    if (!amount || amount <= 0) {
                      alert('Please enter a valid amount.');
                      return;
                    }

                    const originalBtnText = submitPayoutBtn.textContent;
                    submitPayoutBtn.textContent = 'Submitting...';
                    submitPayoutBtn.disabled = true;

                    try {
                      await fetchAPI(`${API_BASE_URL}/payouts`, {
                        method: 'POST',
                        body: JSON.stringify({
                          amount: parseFloat(amount),
                          method: method,
                          notes: notes
                        })
                      });

                      alert(`Payout request for $${amount} submitted successfully!`);

                      document.getElementById('payout-modal').classList.add('hidden');
                      amountInput.value = '';
                      if (notesInput) notesInput.value = '';

                      fetchPayouts();

                    } catch (error) {
                      console.error('Payout request failed:', error);
                      alert('Failed to submit payout request: ' + error.message);
                    } finally {
                      submitPayoutBtn.textContent = originalBtnText;
                      submitPayoutBtn.disabled = false;
                    }
                  });
                }

                // Initialize
                fetchCompanyDetails();
                fetchPayouts();
              })();
            </script>
          </body>

          </html>
