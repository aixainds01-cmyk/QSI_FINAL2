    <script>
        // State
        let vendors = [];
        let selectedVendors = new Set();
        let vendorToDelete = null;
        let vendorsToDelete = [];

        // API Config
        const API_BASE_URL = 'https://api.fornowauto.com/api/vend';

        // Auth
        function getAuthToken() { return localStorage.getItem('token'); }
        function getAuthHeaders() { return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${getAuthToken()}` }; }

        document.addEventListener('DOMContentLoaded', () => {
            loadVendors();
            initEventListeners();
        });

        function initEventListeners() {
            // Dropdowns & Menu
            document.getElementById('documents-dropdown-btn').addEventListener('click', () => {
                document.getElementById('documents-dropdown-content').classList.toggle('hidden');
                document.getElementById('dropdown-icon').classList.toggle('rotate-180');
            });

             document.getElementById('purchases-dropdown-btn').addEventListener('click', () => {
                document.getElementById('purchases-dropdown-content').classList.toggle('hidden');
                document.getElementById('purchases-dropdown-icon').classList.toggle('rotate-180');
            });

            const menuToggle = document.getElementById('menu-toggle');
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('menu-backdrop');
            if(menuToggle && sidebar){
                menuToggle.addEventListener('click', () => { sidebar.classList.toggle('-translate-x-full'); backdrop.classList.toggle('hidden'); });
                backdrop.addEventListener('click', () => { sidebar.classList.add('-translate-x-full'); backdrop.classList.add('hidden'); });
            }

            // Vendor Actions
            document.getElementById('create-vendor-btn').addEventListener('click', () => window.location.href = 'create_vendor_leads.html');
            document.getElementById('refresh-btn').addEventListener('click', loadVendors);
            document.getElementById('search-input').addEventListener('input', (e) => filterVendors(e.target.value));
            document.getElementById('download-csv-btn').addEventListener('click', downloadCSV);
            
            // Selection Logic
            document.getElementById('select-all').addEventListener('change', (e) => {
                document.querySelectorAll('.vendor-checkbox').forEach(cb => {
                    cb.checked = e.target.checked;
                    e.target.checked ? selectedVendors.add(cb.dataset.vendorId) : selectedVendors.delete(cb.dataset.vendorId);
                });
                updateActionBar();
            });

            document.getElementById('deselect-all-btn').addEventListener('click', () => {
                selectedVendors.clear();
                document.querySelectorAll('.vendor-checkbox').forEach(cb => cb.checked = false);
                document.getElementById('select-all').checked = false;
                updateActionBar();
            });

            // Delete Logic
            document.getElementById('delete-selected-btn').addEventListener('click', () => {
                vendorsToDelete = Array.from(selectedVendors);
                document.getElementById('delete-message').textContent = `Delete ${vendorsToDelete.length} items?`;
                document.getElementById('delete-modal').classList.remove('hidden');
            });

            document.getElementById('confirm-delete-btn').addEventListener('click', confirmDelete);
        }

        async function loadVendors() {
            const token = getAuthToken();
            if (!token) { window.location.href = '../../login.html'; return; }
            
            document.getElementById('loading-row').classList.remove('hidden');
            document.getElementById('empty-row').classList.add('hidden');
            document.querySelectorAll('.vendor-row').forEach(r => r.remove());

            try {
                const response = await fetch(API_BASE_URL, { headers: getAuthHeaders() });
                if (response.status === 401) { localStorage.removeItem('token'); window.location.href = '../../login.html'; return; }
                if (!response.ok) throw new Error('Fetch failed');
                
                vendors = await response.json();
                renderVendors(vendors);
                updateCounts();
            } catch (error) {
                console.error(error);
                alert('Failed to load vendors');
            } finally {
                document.getElementById('loading-row').classList.add('hidden');
            }
        }

        function renderVendors(list) {
            const tbody = document.getElementById('vendor-table-body');
            tbody.querySelectorAll('.vendor-row').forEach(r => r.remove());

            if (list.length === 0) {
                document.getElementById('empty-row').classList.remove('hidden');
                return;
            } else {
                document.getElementById('empty-row').classList.add('hidden');
            }

            list.forEach(vendor => {
                const id = vendor._id || vendor.id;
                const tr = document.createElement('tr');
                tr.className = 'vendor-row table-row';
                tr.innerHTML = `
                    <td class="px-6 py-4"><input type="checkbox" class="vendor-checkbox rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" data-vendor-id="${id}"></td>
                    <td class="px-6 py-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-full gradient-bg flex items-center justify-center text-white font-semibold">${(vendor.vendor_name || 'V').charAt(0).toUpperCase()}</div>
                            <div>
                                <div class="font-semibold text-gray-900">${vendor.vendor_name || 'N/A'}</div>
                                <div class="text-sm text-gray-500">${vendor.vendor_type || 'Individual'}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4"><span class="text-gray-700">${vendor.country_code || '+91'} ${vendor.phone || 'N/A'}</span></td>
                    <td class="px-6 py-4"><span class="text-gray-700">${vendor.email || 'N/A'}</span></td>
                    <td class="px-6 py-4"><span class="text-gray-700">${vendor.country || 'N/A'}</span></td>
                    <td class="px-6 py-4"><span class="badge px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">Active</span></td>
                    <td class="px-6 py-4">
                        <div class="flex justify-center space-x-2">
                            <button onclick="viewVendor('${id}')" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg action-btn" title="View"><i class="fas fa-eye"></i></button>
                            <button onclick="editVendor('${id}')" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg action-btn" title="Edit"><i class="fas fa-edit"></i></button>
                            <button onclick="deleteVendor('${id}')" class="p-2 text-red-600 hover:bg-red-50 rounded-lg action-btn" title="Delete"><i class="fas fa-trash"></i></button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            // Re-attach checkbox listeners
            document.querySelectorAll('.vendor-checkbox').forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const id = e.target.dataset.vendorId;
                    e.target.checked ? selectedVendors.add(id) : selectedVendors.delete(id);
                    updateActionBar();
                });
            });
        }

        // ================= NEW VIEW MODAL LOGIC =================
        async function viewVendor(id) {
            const modal = document.getElementById('view-modal');
            const loading = document.getElementById('modal-loading');
            const content = document.getElementById('modal-content');
            const editBtn = document.getElementById('modal-edit-btn');

            // Open Modal
            modal.classList.remove('hidden');
            loading.classList.remove('hidden');
            content.classList.add('hidden');

            try {
                // Fetch Data
                const response = await fetch(`${API_BASE_URL}/${id}`, { headers: getAuthHeaders() });
                if (!response.ok) throw new Error('Failed to fetch details');
                const data = await response.json();

                // Populate Data into Inputs (Setting value, not textContent)
                document.getElementById('modal-vendor-id-display').textContent = `ID: ${id}`;
                document.getElementById('view-name').value = data.vendor_name || '';
                
                // Radio Buttons
                if ((data.vendor_type || '').toLowerCase() === 'company') {
                    document.getElementById('view-vendor-company').checked = true;
                } else {
                    document.getElementById('view-vendor-individual').checked = true;
                }

                document.getElementById('view-subject').value = data.subject || '';
                document.getElementById('view-country-code').value = data.country_code || '';
                document.getElementById('view-phone').value = data.phone || '';
                document.getElementById('view-email').value = data.email || '';
                
                document.getElementById('view-street').value = data.street || '';
                document.getElementById('view-city').value = data.city || '';
                document.getElementById('view-state').value = data.state || '';
                document.getElementById('view-country').value = data.country || '';
                document.getElementById('view-pincode').value = data.pincode || '';
                
                document.getElementById('view-gstin').value = data.gstin || '';
                document.getElementById('view-pan').value = data.pan || '';
                document.getElementById('view-pan-name').value = data.pan_name || '';

                // Setup Edit Button
                editBtn.onclick = () => window.location.href = `edit_vendor_leads.html?id=${id}`;

                // Show Content
                loading.classList.add('hidden');
                content.classList.remove('hidden');

            } catch (error) {
                console.error(error);
                alert('Error loading details');
                closeViewModal();
            }
        }

        function closeViewModal() {
            document.getElementById('view-modal').classList.add('hidden');
        }

        // Close modal when clicking outside
        document.getElementById('view-modal').addEventListener('click', (e) => {
            if (e.target.id === 'view-modal') closeViewModal();
        });

        // ================= END VIEW MODAL LOGIC =================

        function editVendor(id) { window.location.href = `edit_vendor_leads.html?id=${id}`; }

        function deleteVendor(id) {
            vendorToDelete = id;
            vendorsToDelete = [id];
            document.getElementById('delete-message').textContent = 'Are you sure you want to delete this vendor?';
            document.getElementById('delete-modal').classList.remove('hidden');
        }

        async function confirmDelete() {
            try {
                const promises = vendorsToDelete.map(id => fetch(`${API_BASE_URL}/${id}`, { method: 'DELETE', headers: getAuthHeaders() }));
                await Promise.all(promises);
                vendors = vendors.filter(v => !vendorsToDelete.includes(v._id || v.id));
                selectedVendors.clear();
                document.getElementById('select-all').checked = false;
                renderVendors(vendors);
                updateCounts();
                updateActionBar();
                document.getElementById('delete-modal').classList.add('hidden');
                alert('Deleted successfully');
            } catch (error) {
                alert('Delete failed');
            }
        }

        function filterVendors(term) {
            const lower = term.toLowerCase();
            const filtered = vendors.filter(v => (v.vendor_name || '').toLowerCase().includes(lower) || (v.phone || '').includes(lower));
            renderVendors(filtered);
            document.getElementById('showing-count').textContent = filtered.length;
        }

        function updateActionBar() {
            const bar = document.getElementById('action-bar');
            if (selectedVendors.size > 0) {
                bar.classList.remove('hidden');
                document.getElementById('selected-count').textContent = selectedVendors.size;
            } else {
                bar.classList.add('hidden');
            }
        }

        function updateCounts() {
            document.getElementById('vendor-count').textContent = vendors.length;
            document.getElementById('total-count').textContent = vendors.length;
            document.getElementById('showing-count').textContent = vendors.length;
            document.getElementById('last-updated').textContent = new Date().toLocaleTimeString();
        }

        function downloadCSV() {
            alert('CSV Download logic here'); 
        }
    </script>
</body>
</html>