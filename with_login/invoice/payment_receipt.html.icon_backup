<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Receipt</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <style>
        body {
            font-family: "Inter", sans-serif;
            background-color: #f9fafb;
        }

        .form-container {
            max-width: 960px;
            margin: 2rem auto;
        }

        .form-section {
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 1.5rem;
            background-color: white;
        }

        .input-field {
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            transition: all 0.2s ease;
            width: 100%;
            font-size: 0.875rem;
        }

        .input-field:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.2);
            outline: none;
        }

        .input-field[readonly] {
            background-color: #f3f4f6;
            cursor: not-allowed;
        }

        .btn {
            padding: 0.625rem 1rem;
            border-radius: 0.375rem;
            font-weight: 600;
            transition: all 0.2s ease;
            border: 1px solid transparent;
            cursor: pointer;
        }

        .btn-primary {
            background-color: #4f46e5;
            color: white;
        }

        .btn-primary:hover {
            background-color: #4338ca;
        }

        .btn-primary:disabled {
            background-color: #9ca3af;
            cursor: not-allowed;
        }

        .btn-secondary {
            background-color: #e5e7eb;
            color: #374151;
            border-color: #d1d5db;
        }

        .btn-secondary:hover {
            background-color: #d1d5db;
        }

        .btn-success {
            background-color: #10b981;
            color: white;
        }

        .btn-success:hover {
            background-color: #059669;
        }

        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }

        .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }

        .alert-error {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
        }

        .alert-info {
            background-color: #d1ecf1;
            border-color: #bee5eb;
            color: #0c5460;
        }

        /* Display field for view mode */
        .display-field {
            background-color: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            min-height: 38px;
        }

        /* Payment method badges */
        .payment-method-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .method-cash {
            background-color: #d1fae5;
            color: #065f46;
        }

        .method-bank {
            background-color: #dbeafe;
            color: #1e40af;
        }

        .method-upi {
            background-color: #fce7f3;
            color: #9d174d;
        }

        .method-card {
            background-color: #fef3c7;
            color: #92400e;
        }

        .method-cheque {
            background-color: #e0e7ff;
            color: #3730a3;
        }

        /* Receipt preview styles */
        .receipt-container {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            padding: 40px;
            background-color: white;
            border: 1px solid #e5e7eb;
            max-width: 600px;
            margin: 0 auto;
        }

        .receipt-header {
            text-align: center;
            border-bottom: 2px solid #10b981;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .receipt-logo {
            max-width: 120px;
            max-height: 60px;
            margin: 0 auto 10px;
        }

        .receipt-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: #10b981;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .receipt-number {
            font-size: 0.875rem;
            color: #6b7280;
            margin-top: 5px;
        }

        .receipt-body {
            margin-bottom: 30px;
        }

        .receipt-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px dashed #e5e7eb;
        }

        .receipt-row:last-child {
            border-bottom: none;
        }

        .receipt-label {
            color: #6b7280;
            font-size: 0.875rem;
        }

        .receipt-value {
            color: #111827;
            font-weight: 500;
            font-size: 0.875rem;
            text-align: right;
        }

        .receipt-amount-section {
            background-color: #f0fdf4;
            border: 2px solid #10b981;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
        }

        .receipt-amount-label {
            font-size: 0.875rem;
            color: #065f46;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .receipt-amount-value {
            font-size: 2rem;
            font-weight: bold;
            color: #059669;
            margin-top: 5px;
        }

        .receipt-amount-words {
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 5px;
            font-style: italic;
        }

        .receipt-footer {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
        }

        .receipt-footer p {
            font-size: 0.75rem;
            color: #9ca3af;
            margin: 5px 0;
        }

        .receipt-signature {
            margin-top: 30px;
            text-align: right;
        }

        .signature-line {
            border-top: 1px solid #374151;
            width: 200px;
            margin-left: auto;
            padding-top: 5px;
            font-size: 0.75rem;
            color: #6b7280;
        }

        /* Invoice selection card */
        .invoice-card {
            border: 2px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .invoice-card:hover {
            border-color: #4f46e5;
            background-color: #f5f3ff;
        }

        .invoice-card.selected {
            border-color: #10b981;
            background-color: #f0fdf4;
        }

        .invoice-card .invoice-number {
            font-weight: 600;
            color: #111827;
        }

        .invoice-card .invoice-client {
            font-size: 0.875rem;
            color: #6b7280;
        }

        .invoice-card .invoice-amount {
            font-weight: 600;
            color: #059669;
        }

        .invoice-card .invoice-balance {
            font-size: 0.875rem;
            color: #dc2626;
        }

        @media (max-width: 768px) {
            #main-content {
                margin-top: 64px;
            }
        }
    </style>
    <link rel="stylesheet" href="../../js/theme-force.css">
    <!-- Global Theme Manager -->
    <script src="../../js/theme-manager.js"></script>
</head>

<body>
    <div class="flex min-h-screen">
        <!-- Mobile Header -->
        <header class="bg-gray-800 text-white flex items-center justify-between p-4 md:hidden fixed top-0 left-0 w-full z-50 shadow-md">
            <div class="flex items-center space-x-3">
                <button id="menu-toggle" class="text-white focus:outline-none">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
                <span class="text-xl font-bold">QSI</span>
            </div>
        </header>

        <!-- BACKDROP for mobile -->
        <div id="menu-backdrop" class="fixed inset-0 bg-black bg-opacity-50 hidden md:hidden z-40"></div>

        <!-- SIDEBAR -->
        <aside id="sidebar"
            class="w-64 bg-gray-800 text-white h-screen fixed md:h-screen fixed md:sticky top-0 left-0 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50 flex flex-col shadow-lg">
            <div class="p-6 text-2xl font-bold border-b border-gray-700">
                <i class="mr-2 text-indigo-400"></i> QSI
            </div>
            <nav class="flex-1 p-4 space-y-2">
                <a href="../dashboard_with_login.html"
                    class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
                    <i class="fas fa-chart-pie mr-3"></i>Dashboard
                </a>
                <div>
                    <button id="documents-dropdown-btn"
                        class="w-full flex justify-between items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 text-left">
                        <span class="flex items-center"><i class="fas fa-file-invoice mr-3"></i>Sales Documents</span>
                        <i id="dropdown-icon" class="fas fa-chevron-down transform transition-transform duration-200 rotate-180"></i>
                    </button>
                    <div id="documents-dropdown-content" class="pl-8 pt-2 space-y-1">
                        <a href="../quotation/home_quotation.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Quotation</a>
                        <a href="../sales_order/home_sales_order.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Sales Order</a>
                        <a href="home_invoice.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Invoice</a>
                        <a href="payment_receipt.html"
                            class="block py-2 px-4 rounded transition duration-200 bg-gray-700 text-sm">Payment Receipt</a>
                        <a href="../credit_note.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Credit Note</a>
                    </div>
                    <div>
                        <button id="purchases-dropdown-btn"
                            class="w-full flex justify-between items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 text-left">
                            <span class="flex items-center"><i class="fas fa-shopping-cart mr-3"></i>Purchases</span>
                            <i id="purchases-dropdown-icon" class="fas fa-chevron-down transform transition-transform duration-200"></i>
                        </button>
                        <div id="purchases-dropdown-content" class="pl-8 pt-2 space-y-1 hidden">
                            <a href="../parchase/vendor/vendors_leads.html"
                                class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Vendors Leads</a>
                            <a href="../parchase/parchase_order/home_purchase_orders.html"
                                class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Purchase Orders</a>
                            <a href="../parchase/debit notes/debit_notes.html"
                                class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Debit Notes</a>
                        </div>
                    </div>
                </div>
                <a href="../manage-clients.html"
                    class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
                    <i class="fas fa-users mr-3"></i>Manage Clients
                </a>
                <a href="../settings.html"
                    class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
                    <i class="fas fa-cog mr-3"></i>Settings
                </a>
            </nav>
        </aside>

        <div id="main-content" class="flex-1 overflow-y-auto">
            <div class="w-full max-w-5xl mx-auto p-6">
                
                <!-- Create Payment Receipt Page -->
                <div id="create-receipt-page">
                    <main class="form-container">
                        <form id="receipt-form">
                            <div class="flex justify-between items-center mb-6">
                                <h1 class="text-3xl font-bold text-gray-800">
                                    <i class="fas fa-receipt text-green-600 mr-2"></i>Record Payment
                                </h1>
                                <div class="flex items-center space-x-2">
                                    <a href="home_invoice.html" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left mr-2"></i> Back to Invoices
                                    </a>
                                </div>
                            </div>

                            <div id="alert-container"></div>

                            <div class="form-section space-y-6">
                                <!-- Receipt Info -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <div class="grid grid-cols-3 gap-2 items-center mb-4">
                                            <label class="text-gray-600 text-sm font-medium">Receipt No.</label>
                                            <input type="text" id="receipt-no" class="input-field col-span-2 bg-gray-100"
                                                placeholder="Will be generated" readonly />
                                        </div>

                                        <div class="grid grid-cols-3 gap-2 items-center mb-4">
                                            <label class="text-gray-600 text-sm font-medium">Payment Date</label>
                                            <input type="date" id="payment-date" class="input-field col-span-2" required />
                                        </div>
                                    </div>
                                    <div id="logo-container"
                                        class="border-2 border-dashed rounded-lg flex flex-col items-center justify-center p-4 text-center bg-gray-50">
                                        <img id="logo-preview" src="" alt="Business Logo" class="max-w-[150px] max-h-[70px] object-contain hidden" />
                                        <div id="logo-placeholder" class="text-gray-400">
                                            <i class="fas fa-image text-2xl mb-2"></i>
                                            <span class="block text-sm">Company Logo</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Select Invoice Section -->
                                <div class="border rounded-lg p-4">
                                    <h3 class="font-semibold text-gray-700 mb-4">
                                        <i class="fas fa-file-invoice-dollar mr-2"></i>Select Invoice
                                    </h3>
                                    
                                    <!-- Invoice Search -->
                                    <div class="mb-4">
                                        <div class="relative">
                                            <input type="text" id="invoice-search" class="input-field pl-10" 
                                                placeholder="Search by invoice number or client name...">
                                            <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                        </div>
                                    </div>

                                    <!-- Invoice List -->
                                    <div id="invoice-list" class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-64 overflow-y-auto">
                                        <!-- Invoices will be populated here -->
                                    </div>

                                    <!-- Selected Invoice Info -->
                                    <div id="selected-invoice-info" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-lg">
                                        <div class="flex justify-between items-start">
                                            <div>
                                                <h4 class="font-semibold text-green-800">Selected Invoice</h4>
                                                <p id="selected-invoice-number" class="text-green-700"></p>
                                                <p id="selected-invoice-client" class="text-sm text-green-600"></p>
                                            </div>
                                            <div class="text-right">
                                                <p class="text-sm text-gray-600">Invoice Total</p>
                                                <p id="selected-invoice-total" class="font-bold text-gray-800"></p>
                                                <p class="text-sm text-gray-600 mt-1">Balance Due</p>
                                                <p id="selected-invoice-balance" class="font-bold text-red-600"></p>
                                            </div>
                                        </div>
                                        <button type="button" id="clear-invoice-btn" class="mt-2 text-sm text-red-600 hover:underline">
                                            <i class="fas fa-times mr-1"></i>Clear Selection
                                        </button>
                                    </div>
                                    <input type="hidden" id="selected-invoice-id">
                                </div>

                                <!-- Payment Details -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <!-- Payment Amount -->
                                    <div class="border rounded-lg p-4 space-y-4">
                                        <h3 class="font-semibold text-gray-700">
                                            <i class="fas fa-money-bill-wave mr-2"></i>Payment Details
                                        </h3>
                                        
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">Amount Received *</label>
                                            <div class="relative mt-1">
                                                <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500">₹</span>
                                                <input type="number" id="amount-received" class="input-field pl-8" 
                                                    placeholder="0.00" min="0" step="0.01" required>
                                            </div>
                                            <p id="amount-hint" class="text-xs text-gray-500 mt-1"></p>
                                        </div>

                                        <div>
                                            <label class="text-sm font-medium text-gray-600">Payment Method *</label>
                                            <select id="payment-method" class="input-field mt-1" required>
                                                <option value="">Select Payment Method</option>
                                                <option value="cash">💵 Cash</option>
                                                <option value="bank_transfer">🏦 Bank Transfer</option>
                                                <option value="upi">📱 UPI</option>
                                                <option value="card">💳 Credit/Debit Card</option>
                                                <option value="cheque">📄 Cheque</option>
                                            </select>
                                        </div>

                                        <!-- Conditional fields based on payment method -->
                                        <div id="bank-details" class="hidden space-y-3">
                                            <div>
                                                <label class="text-sm font-medium text-gray-600">Bank Name</label>
                                                <input type="text" id="bank-name" class="input-field mt-1" placeholder="Bank name">
                                            </div>
                                            <div>
                                                <label class="text-sm font-medium text-gray-600">Transaction ID</label>
                                                <input type="text" id="transaction-id" class="input-field mt-1" placeholder="Transaction ID">
                                            </div>
                                        </div>

                                        <div id="upi-details" class="hidden">
                                            <label class="text-sm font-medium text-gray-600">UPI Transaction ID</label>
                                            <input type="text" id="upi-id" class="input-field mt-1" placeholder="UPI Transaction ID">
                                        </div>

                                        <div id="cheque-details" class="hidden space-y-3">
                                            <div>
                                                <label class="text-sm font-medium text-gray-600">Cheque Number</label>
                                                <input type="text" id="cheque-number" class="input-field mt-1" placeholder="Cheque number">
                                            </div>
                                            <div>
                                                <label class="text-sm font-medium text-gray-600">Cheque Date</label>
                                                <input type="date" id="cheque-date" class="input-field mt-1">
                                            </div>
                                            <div>
                                                <label class="text-sm font-medium text-gray-600">Bank Name</label>
                                                <input type="text" id="cheque-bank" class="input-field mt-1" placeholder="Bank name">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Client Info (Read-only) -->
                                    <div class="border rounded-lg p-4 space-y-4 bg-gray-50">
                                        <h3 class="font-semibold text-gray-700">
                                            <i class="fas fa-user mr-2"></i>Received From
                                        </h3>
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">Client Name</label>
                                            <div id="client-name" class="display-field mt-1">-</div>
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">Client Address</label>
                                            <div id="client-address" class="display-field mt-1">-</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Notes -->
                                <div>
                                    <label class="text-sm font-medium text-gray-600">
                                        <i class="fas fa-sticky-note mr-1"></i>Notes (Optional)
                                    </label>
                                    <textarea id="payment-notes" class="input-field mt-1" rows="3" 
                                        placeholder="Add any notes about this payment..."></textarea>
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex justify-end gap-3 pt-4 border-t">
                                    <button type="button" id="preview-btn" class="btn btn-secondary">
                                        <i class="fas fa-eye mr-2"></i>Preview Receipt
                                    </button>
                                    <button type="submit" id="save-btn" class="btn btn-success">
                                        <i class="fas fa-save mr-2"></i>Record Payment
                                    </button>
                                </div>
                            </div>
                        </form>
                    </main>
                </div>

                <!-- Preview Receipt Page -->
                <div id="preview-receipt-page" class="hidden">
                    <div class="flex justify-between items-center mb-6">
                        <h1 class="text-3xl font-bold text-gray-800">
                            <i class="fas fa-receipt text-green-600 mr-2"></i>Payment Receipt
                        </h1>
                        <div class="flex items-center space-x-2">
                            <button id="back-to-form-btn" class="btn btn-secondary">
                                <i class="fas fa-arrow-left mr-2"></i>Back to Form
                            </button>
                            <button id="download-pdf-btn" class="btn btn-primary">
                                <i class="fas fa-download mr-2"></i>Download PDF
                            </button>
                            <button id="print-btn" class="btn btn-success">
                                <i class="fas fa-print mr-2"></i>Print
                            </button>
                        </div>
                    </div>

                    <!-- Receipt Preview -->
                    <div id="receipt-preview-container" class="receipt-container shadow-lg">
                        <header class="receipt-header">
                            <img id="preview-logo" src="" alt="Logo" class="receipt-logo hidden">
                            <h1 class="receipt-title">Payment Receipt</h1>
                            <p class="receipt-number">Receipt No: <span id="preview-receipt-no"></span></p>
                        </header>

                        <div class="receipt-body">
                            <div class="receipt-row">
                                <span class="receipt-label">Date</span>
                                <span class="receipt-value" id="preview-date"></span>
                            </div>
                            <div class="receipt-row">
                                <span class="receipt-label">Received From</span>
                                <span class="receipt-value" id="preview-client"></span>
                            </div>
                            <div class="receipt-row">
                                <span class="receipt-label">Against Invoice</span>
                                <span class="receipt-value" id="preview-invoice-no"></span>
                            </div>
                            <div class="receipt-row">
                                <span class="receipt-label">Payment Method</span>
                                <span class="receipt-value" id="preview-method"></span>
                            </div>
                            <div id="preview-transaction-row" class="receipt-row hidden">
                                <span class="receipt-label">Transaction/Reference</span>
                                <span class="receipt-value" id="preview-transaction"></span>
                            </div>
                        </div>

                        <div class="receipt-amount-section">
                            <p class="receipt-amount-label">Amount Received</p>
                            <p class="receipt-amount-value" id="preview-amount"></p>
                            <p class="receipt-amount-words" id="preview-amount-words"></p>
                        </div>

                        <div class="receipt-body">
                            <div class="receipt-row">
                                <span class="receipt-label">Invoice Total</span>
                                <span class="receipt-value" id="preview-invoice-total"></span>
                            </div>
                            <div class="receipt-row">
                                <span class="receipt-label">Previous Payments</span>
                                <span class="receipt-value" id="preview-previous-payments"></span>
                            </div>
                            <div class="receipt-row">
                                <span class="receipt-label">This Payment</span>
                                <span class="receipt-value text-green-600 font-bold" id="preview-this-payment"></span>
                            </div>
                            <div class="receipt-row" style="border-top: 2px solid #111827; padding-top: 15px;">
                                <span class="receipt-label font-bold">Balance Due</span>
                                <span class="receipt-value font-bold" id="preview-balance"></span>
                            </div>
                        </div>

                        <div id="preview-notes-section" class="hidden" style="margin-top: 20px; padding: 15px; background-color: #f9fafb; border-radius: 8px;">
                            <p style="font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 1px;">Notes</p>
                            <p id="preview-notes" style="font-size: 0.875rem; color: #374151; margin-top: 5px;"></p>
                        </div>

                        <div class="receipt-signature">
                            <div class="signature-line">Authorized Signature</div>
                        </div>

                        <footer class="receipt-footer">
                            <p id="preview-company-name"></p>
                            <p id="preview-company-address"></p>
                            <p style="margin-top: 10px;">Thank you for your payment!</p>
                        </footer>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const API_BASE_URL = "https://api.fornowauto.com/api";
            const COMPANY_API_URL = `${API_BASE_URL}/companies`;
            const INVOICE_API_URL = `${API_BASE_URL}/invoic`;
            const PAYMENT_API_URL = `${API_BASE_URL}/payments`;

            // Elements
            const receiptForm = document.getElementById("receipt-form");
            const alertContainer = document.getElementById("alert-container");
            const createPage = document.getElementById("create-receipt-page");
            const previewPage = document.getElementById("preview-receipt-page");
            const invoiceSearch = document.getElementById("invoice-search");
            const invoiceList = document.getElementById("invoice-list");
            const selectedInvoiceInfo = document.getElementById("selected-invoice-info");
            const paymentMethod = document.getElementById("payment-method");
            const amountReceived = document.getElementById("amount-received");
            const previewBtn = document.getElementById("preview-btn");
            const backToFormBtn = document.getElementById("back-to-form-btn");
            const downloadPdfBtn = document.getElementById("download-pdf-btn");
            const printBtn = document.getElementById("print-btn");
            const clearInvoiceBtn = document.getElementById("clear-invoice-btn");

            const menuToggle = document.getElementById("menu-toggle");
            const sidebar = document.getElementById("sidebar");
            const menuBackdrop = document.getElementById("menu-backdrop");

            let companyData = null;
            let allInvoices = [];
            let selectedInvoice = null;

            // Mobile menu toggle
            if (menuToggle && sidebar && menuBackdrop) {
                menuToggle.addEventListener("click", () => {
                    sidebar.classList.toggle("-translate-x-full");
                    menuBackdrop.classList.toggle("hidden");
                });
                menuBackdrop.addEventListener("click", () => {
                    sidebar.classList.add("-translate-x-full");
                    menuBackdrop.classList.add("hidden");
                });
            }

            // === Utility Functions ===
            function showAlert(message, type = "success", duration = 5000) {
                if (!alertContainer) return;
                const alertDiv = document.createElement("div");
                alertDiv.className = `alert alert-${type}`;
                alertDiv.textContent = message;
                alertContainer.innerHTML = '';
                alertContainer.appendChild(alertDiv);
                setTimeout(() => alertDiv.remove(), duration);
            }

            function getAuthHeaders() {
                const token = localStorage.getItem("token");
                return token ? { 'Authorization': `Bearer ${token}` } : null;
            }

            async function safeFetch(url, opts = {}) {
                const headers = Object.assign({}, opts.headers || {});
                const authHeaders = getAuthHeaders();
                if (!authHeaders) {
                    alert("Authentication token not found. Please log in.");
                    window.location.href = '../../index.html';
                    throw new Error("Authentication token not found.");
                }
                Object.assign(headers, authHeaders);
                if (opts.body && !(opts.body instanceof FormData) && !headers["Content-Type"]) {
                    headers["Content-Type"] = "application/json";
                }
                const res = await fetch(url, { ...opts, headers });
                const text = await res.text();
                let data;
                try { data = text ? JSON.parse(text) : null; } catch { data = text; }
                if (!res.ok) {
                    if (res.status === 401) {
                        alert("Session expired. Please log in again.");
                        localStorage.removeItem('token');
                        window.location.href = '../../index.html';
                    }
                    throw new Error(data?.message || res.statusText || "Request failed");
                }
                return data;
            }

            function formatDate(dateStr) {
                if (!dateStr) return '-';
                const date = new Date(dateStr);
                return date.toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            function formatCurrency(amount) {
                return `₹${(amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }

            function numberToWords(num) {
                const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
                    'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
                const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

                if (num === 0) return 'Zero Rupees Only';

                function convertLessThanThousand(n) {
                    if (n === 0) return '';
                    if (n < 20) return ones[n];
                    if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 ? ' ' + ones[n % 10] : '');
                    return ones[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' ' + convertLessThanThousand(n % 100) : '');
                }

                let result = '';
                const crore = Math.floor(num / 10000000);
                const lakh = Math.floor((num % 10000000) / 100000);
                const thousand = Math.floor((num % 100000) / 1000);
                const remainder = Math.floor(num % 1000);

                if (crore) result += convertLessThanThousand(crore) + ' Crore ';
                if (lakh) result += convertLessThanThousand(lakh) + ' Lakh ';
                if (thousand) result += convertLessThanThousand(thousand) + ' Thousand ';
                if (remainder) result += convertLessThanThousand(remainder);

                return result.trim() + ' Rupees Only';
            }

            function generateReceiptNo() {
                const date = new Date();
                const year = date.getFullYear().toString().slice(-2);
                const month = (date.getMonth() + 1).toString().padStart(2, '0');
                const random = Math.floor(Math.random() * 1000).toString().padStart(3, '0');
                return `RCP-${year}${month}-${random}`;
            }

            // === Load Company ===
            async function loadCompany() {
                try {
                    const companies = await safeFetch(COMPANY_API_URL, { method: "GET" });
                    if (Array.isArray(companies) && companies.length > 0) {
                        companyData = companies[0];
                        if (companyData.logo) {
                            document.getElementById("logo-preview").src = companyData.logo;
                            document.getElementById("logo-preview").classList.remove("hidden");
                            document.getElementById("logo-placeholder").classList.add("hidden");
                        }
                    }
                } catch (err) {
                    console.error("Error loading company:", err);
                }
            }

            // === Load Invoices ===
            async function loadInvoices() {
                try {
                    const response = await safeFetch(INVOICE_API_URL, { method: "GET" });
                    allInvoices = Array.isArray(response) ? response : (response?.data || response?.invoices || []);
                    
                    // Filter to show only invoices with balance due
                    const pendingInvoices = allInvoices.filter(inv => {
                        const total = inv.total || 0;
                        const paid = inv.paid_amount || 0;
                        return (total - paid) > 0;
                    });

                    renderInvoiceList(pendingInvoices);
                } catch (err) {
                    console.error("Error loading invoices:", err);
                    showAlert("Could not load invoices.", "error");
                }
            }

            function renderInvoiceList(invoices) {
                invoiceList.innerHTML = '';

                if (invoices.length === 0) {
                    invoiceList.innerHTML = `
                        <div class="col-span-2 text-center py-8 text-gray-500">
                            <i class="fas fa-check-circle text-4xl text-green-500 mb-2"></i>
                            <p>All invoices are fully paid!</p>
                        </div>
                    `;
                    return;
                }

                invoices.forEach(invoice => {
                    const total = invoice.total || 0;
                    const paid = invoice.paid_amount || 0;
                    const balance = total - paid;

                    const card = document.createElement("div");
                    card.className = "invoice-card";
                    card.dataset.invoiceId = invoice._id || invoice.id;
                    card.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="invoice-number">${invoice.invoice_no || 'N/A'}</p>
                                <p class="invoice-client">${invoice.to?.client_name || 'Unknown Client'}</p>
                                <p class="text-xs text-gray-400 mt-1">${formatDate(invoice.date)}</p>
                            </div>
                            <div class="text-right">
                                <p class="invoice-amount">${formatCurrency(total)}</p>
                                <p class="invoice-balance">Due: ${formatCurrency(balance)}</p>
                            </div>
                        </div>
                    `;

                    card.addEventListener("click", () => selectInvoice(invoice));
                    invoiceList.appendChild(card);
                });
            }

            function selectInvoice(invoice) {
                selectedInvoice = invoice;
                document.getElementById("selected-invoice-id").value = invoice._id || invoice.id;

                // Update UI
                document.querySelectorAll(".invoice-card").forEach(card => {
                    card.classList.remove("selected");
                    if (card.dataset.invoiceId === (invoice._id || invoice.id)) {
                        card.classList.add("selected");
                    }
                });

                // Show selected invoice info
                const total = invoice.total || 0;
                const paid = invoice.paid_amount || 0;
                const balance = total - paid;

                document.getElementById("selected-invoice-number").textContent = invoice.invoice_no || 'N/A';
                document.getElementById("selected-invoice-client").textContent = invoice.to?.client_name || 'Unknown';
                document.getElementById("selected-invoice-total").textContent = formatCurrency(total);
                document.getElementById("selected-invoice-balance").textContent = formatCurrency(balance);
                selectedInvoiceInfo.classList.remove("hidden");

                // Update client info
                document.getElementById("client-name").textContent = invoice.to?.client_name || '-';
                const address = [
                    invoice.to?.address?.city || invoice.to?.address?.['city/town'],
                    invoice.to?.address?.state,
                    invoice.to?.address?.country
                ].filter(Boolean).join(', ');
                document.getElementById("client-address").textContent = address || '-';

                // Set amount hint
                document.getElementById("amount-hint").textContent = `Balance due: ${formatCurrency(balance)}`;

                // Pre-fill amount with balance
                amountReceived.value = balance.toFixed(2);
                amountReceived.max = balance;
            }

            clearInvoiceBtn?.addEventListener("click", () => {
                selectedInvoice = null;
                document.getElementById("selected-invoice-id").value = "";
                selectedInvoiceInfo.classList.add("hidden");
                document.querySelectorAll(".invoice-card").forEach(card => card.classList.remove("selected"));
                document.getElementById("client-name").textContent = '-';
                document.getElementById("client-address").textContent = '-';
                document.getElementById("amount-hint").textContent = '';
                amountReceived.value = '';
            });

            // === Invoice Search ===
            invoiceSearch?.addEventListener("input", (e) => {
                const term = e.target.value.toLowerCase().trim();
                const filtered = allInvoices.filter(inv => {
                    const total = inv.total || 0;
                    const paid = inv.paid_amount || 0;
                    if ((total - paid) <= 0) return false;

                    const invoiceNo = (inv.invoice_no || '').toLowerCase();
                    const clientName = (inv.to?.client_name || '').toLowerCase();
                    return invoiceNo.includes(term) || clientName.includes(term);
                });
                renderInvoiceList(filtered);
            });

            // === Payment Method Change ===
            paymentMethod?.addEventListener("change", () => {
                const method = paymentMethod.value;

                document.getElementById("bank-details").classList.add("hidden");
                document.getElementById("upi-details").classList.add("hidden");
                document.getElementById("cheque-details").classList.add("hidden");

                if (method === "bank_transfer") {
                    document.getElementById("bank-details").classList.remove("hidden");
                } else if (method === "upi") {
                    document.getElementById("upi-details").classList.remove("hidden");
                } else if (method === "cheque") {
                    document.getElementById("cheque-details").classList.remove("hidden");
                }
            });

            // === Preview Receipt ===
            previewBtn?.addEventListener("click", () => {
                if (!validateForm()) return;
                populatePreview();
                createPage.classList.add("hidden");
                previewPage.classList.remove("hidden");
            });

            backToFormBtn?.addEventListener("click", () => {
                previewPage.classList.add("hidden");
                createPage.classList.remove("hidden");
            });

            function validateForm() {
                if (!selectedInvoice) {
                    showAlert("Please select an invoice.", "error");
                    return false;
                }
                if (!amountReceived.value || parseFloat(amountReceived.value) <= 0) {
                    showAlert("Please enter a valid amount.", "error");
                    return false;
                }
                if (!paymentMethod.value) {
                    showAlert("Please select a payment method.", "error");
                    return false;
                }
                return true;
            }

            function populatePreview() {
                const receiptNo = document.getElementById("receipt-no").value || generateReceiptNo();
                document.getElementById("receipt-no").value = receiptNo;

                const amount = parseFloat(amountReceived.value) || 0;
                const total = selectedInvoice.total || 0;
                const previousPaid = selectedInvoice.paid_amount || 0;
                const newBalance = total - previousPaid - amount;

                // Logo
                if (companyData?.logo) {
                    document.getElementById("preview-logo").src = companyData.logo;
                    document.getElementById("preview-logo").classList.remove("hidden");
                }

                // Receipt details
                document.getElementById("preview-receipt-no").textContent = receiptNo;
                document.getElementById("preview-date").textContent = formatDate(document.getElementById("payment-date").value);
                document.getElementById("preview-client").textContent = selectedInvoice.to?.client_name || '-';
                document.getElementById("preview-invoice-no").textContent = selectedInvoice.invoice_no || '-';

                // Payment method
                const methodLabels = {
                    cash: '💵 Cash',
                    bank_transfer: '🏦 Bank Transfer',
                    upi: '📱 UPI',
                    card: '💳 Card',
                    cheque: '📄 Cheque'
                };
                document.getElementById("preview-method").textContent = methodLabels[paymentMethod.value] || paymentMethod.value;

                // Transaction details
                let transactionRef = '';
                if (paymentMethod.value === 'bank_transfer') {
                    transactionRef = document.getElementById("transaction-id").value;
                } else if (paymentMethod.value === 'upi') {
                    transactionRef = document.getElementById("upi-id").value;
                } else if (paymentMethod.value === 'cheque') {
                    transactionRef = document.getElementById("cheque-number").value;
                }

                if (transactionRef) {
                    document.getElementById("preview-transaction-row").classList.remove("hidden");
                    document.getElementById("preview-transaction").textContent = transactionRef;
                } else {
                    document.getElementById("preview-transaction-row").classList.add("hidden");
                }

                // Amount
                document.getElementById("preview-amount").textContent = formatCurrency(amount);
                document.getElementById("preview-amount-words").textContent = numberToWords(Math.round(amount));

                // Invoice breakdown
                document.getElementById("preview-invoice-total").textContent = formatCurrency(total);
                document.getElementById("preview-previous-payments").textContent = formatCurrency(previousPaid);
                document.getElementById("preview-this-payment").textContent = formatCurrency(amount);

                const balanceEl = document.getElementById("preview-balance");
                balanceEl.textContent = formatCurrency(Math.max(0, newBalance));
                if (newBalance <= 0) {
                    balanceEl.style.color = '#059669';
                    balanceEl.textContent = '₹0.00 (Fully Paid)';
                } else {
                    balanceEl.style.color = '#dc2626';
                }

                // Notes
                const notes = document.getElementById("payment-notes").value.trim();
                if (notes) {
                    document.getElementById("preview-notes-section").classList.remove("hidden");
                    document.getElementById("preview-notes").textContent = notes;
                } else {
                    document.getElementById("preview-notes-section").classList.add("hidden");
                }

                // Company info
                document.getElementById("preview-company-name").textContent = companyData?.company_name || '';
                const companyAddress = [
                    companyData?.address?.city,
                    companyData?.address?.state,
                    companyData?.address?.country
                ].filter(Boolean).join(', ');
                document.getElementById("preview-company-address").textContent = companyAddress;
            }

            // === Download PDF ===
            downloadPdfBtn?.addEventListener("click", async () => {
                const element = document.getElementById("receipt-preview-container");

                try {
                    const canvas = await html2canvas(element, {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: '#ffffff'
                    });

                    const { jsPDF } = window.jspdf;
                    const pdf = new jsPDF("p", "mm", "a4");
                    const imgData = canvas.toDataURL("image/jpeg", 0.95);

                    const pageWidth = pdf.internal.pageSize.getWidth();
                    const imgProps = pdf.getImageProperties(imgData);
                    const pdfHeight = (imgProps.height * pageWidth) / imgProps.width;

                    pdf.addImage(imgData, "JPEG", 0, 10, pageWidth, pdfHeight);

                    const receiptNo = document.getElementById("receipt-no").value || 'Receipt';
                    const clientName = (selectedInvoice?.to?.client_name || 'Client').replace(/[^a-zA-Z0-9]/g, '_');
                    pdf.save(`${clientName}_${receiptNo}.pdf`);

                    showAlert("PDF downloaded successfully!", "success");
                } catch (err) {
                    console.error("PDF error:", err);
                    showAlert("Error generating PDF: " + err.message, "error");
                }
            });

            // === Print ===
            printBtn?.addEventListener("click", () => {
                window.print();
            });

            // === Form Submit ===
            receiptForm?.addEventListener("submit", async (e) => {
                e.preventDefault();

                if (!validateForm()) return;

                try {
                    const amount = parseFloat(amountReceived.value) || 0;
                    const receiptNo = document.getElementById("receipt-no").value || generateReceiptNo();

                    // Prepare payment data
                    const paymentData = {
                        receipt_no: receiptNo,
                        invoice_id: selectedInvoice._id || selectedInvoice.id,
                        invoice_no: selectedInvoice.invoice_no,
                        client_id: selectedInvoice.to?._id || selectedInvoice.to_client_id,
                        client_name: selectedInvoice.to?.client_name,
                        payment_date: document.getElementById("payment-date").value,
                        amount: amount,
                        payment_method: paymentMethod.value,
                        notes: document.getElementById("payment-notes").value.trim(),
                        transaction_details: {}
                    };

                    // Add method-specific details
                    if (paymentMethod.value === 'bank_transfer') {
                        paymentData.transaction_details = {
                            bank_name: document.getElementById("bank-name").value,
                            transaction_id: document.getElementById("transaction-id").value
                        };
                    } else if (paymentMethod.value === 'upi') {
                        paymentData.transaction_details = {
                            upi_id: document.getElementById("upi-id").value
                        };
                    } else if (paymentMethod.value === 'cheque') {
                        paymentData.transaction_details = {
                            cheque_number: document.getElementById("cheque-number").value,
                            cheque_date: document.getElementById("cheque-date").value,
                            bank_name: document.getElementById("cheque-bank").value
                        };
                    }

                    // Update invoice with new paid amount
                    const newPaidAmount = (selectedInvoice.paid_amount || 0) + amount;
                    await safeFetch(`${INVOICE_API_URL}/${selectedInvoice._id || selectedInvoice.id}`, {
                        method: "PUT",
                        body: JSON.stringify({ paid_amount: newPaidAmount })
                    });

                    // Try to save payment record (if endpoint exists)
                    try {
                        await safeFetch(PAYMENT_API_URL, {
                            method: "POST",
                            body: JSON.stringify(paymentData)
                        });
                    } catch (err) {
                        console.log("Payment record endpoint not available, continuing...");
                    }

                    showAlert("Payment recorded successfully!", "success");

                    // Show preview
                    populatePreview();
                    createPage.classList.add("hidden");
                    previewPage.classList.remove("hidden");

                } catch (err) {
                    console.error("Error recording payment:", err);
                    showAlert("Error recording payment: " + err.message, "error");
                }
            });

            // === Sidebar Dropdowns ===
            const dropdownBtn = document.getElementById("documents-dropdown-btn");
            const dropdownContent = document.getElementById("documents-dropdown-content");
            const dropdownIcon = document.getElementById("dropdown-icon");
            dropdownBtn?.addEventListener("click", () => {
                dropdownContent?.classList.toggle("hidden");
                dropdownIcon?.classList.toggle("rotate-180");
            });

            const purchasesDropdownBtn = document.getElementById('purchases-dropdown-btn');
            purchasesDropdownBtn?.addEventListener('click', () => {
                document.getElementById('purchases-dropdown-content')?.classList.toggle('hidden');
                document.getElementById('purchases-dropdown-icon')?.classList.toggle('rotate-180');
            });

            // === Initialize ===
            (async function init() {
                // Set today's date
                document.getElementById("payment-date").value = new Date().toISOString().slice(0, 10);

                // Generate receipt number
                document.getElementById("receipt-no").value = generateReceiptNo();

                await loadCompany();
                await loadInvoices();

                // Check if invoice ID is in URL (coming from invoice page)
                const urlParams = new URLSearchParams(window.location.search);
                const invoiceId = urlParams.get("invoice_id");
                if (invoiceId) {
                    const invoice = allInvoices.find(inv => (inv._id || inv.id) === invoiceId);
                    if (invoice) {
                        selectInvoice(invoice);
                    }
                }
            })();
        });
    </script>
</body>

</html>