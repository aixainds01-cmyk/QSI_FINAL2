<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>View Invoice</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <style>
        body {
            font-family: "Inter", sans-serif;
            background-color: #f9fafb;
        }

        .form-container {
            max-width: 960px;
            margin: 2rem auto;
        }

        .form-section {
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 1.5rem;
            background-color: white;
        }

        .btn {
            padding: 0.625rem 1rem;
            border-radius: 0.375rem;
            font-weight: 600;
            transition: all 0.2s ease;
            border: 1px solid transparent;
            cursor: pointer;
        }

        .btn-primary {
            background-color: #4f46e5;
            color: white;
        }

        .btn-primary:hover {
            background-color: #4338ca;
        }

        .btn-secondary {
            background-color: #e5e7eb;
            color: #374151;
            border-color: #d1d5db;
        }

        .btn-secondary:hover {
            background-color: #d1d5db;
        }

        .btn-success {
            background-color: #10b981;
            color: white;
        }

        .btn-success:hover {
            background-color: #059669;
        }

        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }

        .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }

        .alert-error {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
        }

        .alert-info {
            background-color: #d1ecf1;
            border-color: #bee5eb;
            color: #0c5460;
        }

        /* Read-only badge */
        .readonly-badge {
            background-color: #fef3c7;
            color: #92400e;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* Read-only display field styles */
        .display-field {
            background-color: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            min-height: 38px;
        }

        .display-field-lg {
            background-color: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 0.375rem;
            padding: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            min-height: 80px;
            white-space: pre-wrap;
        }

        /* Items table styles */
        .items-table {
            width: 100%;
            border-collapse: collapse;
        }

        .items-table thead {
            background-color: #4338ca;
            color: white;
        }

        .items-table th {
            padding: 0.75rem;
            text-align: left;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .items-table th:nth-child(1) {
            width: 5%;
        }

        .items-table th:nth-child(3),
        .items-table th:nth-child(4),
        .items-table th:nth-child(5) {
            text-align: right;
        }

        .items-table tbody tr {
            border-bottom: 1px solid #e5e7eb;
            background-color: #fafafa;
        }

        .items-table tbody tr:hover {
            background-color: #f3f4f6;
        }

        .items-table td {
            padding: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
        }

        .items-table td:nth-child(3),
        .items-table td:nth-child(4),
        .items-table td:nth-child(5) {
            text-align: right;
        }

        .item-description {
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 0.25rem;
        }

        /* Status badge */
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            font-size: 0.75rem;
            font-weight: 600;
            border-radius: 9999px;
            text-transform: uppercase;
        }

        .status-paid {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #10b981;
        }

        .status-pending {
            background-color: #fef3c7;
            color: #92400e;
            border: 1px solid #f59e0b;
        }

        .status-overdue {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #ef4444;
        }

        @media (max-width: 768px) {
            #main-content {
                margin-top: 64px;
            }
        }

        @media print {
            .no-print {
                display: none !important;
            }
        }
    </style>
    <link rel="stylesheet" href="../../js/theme-force.css">
    <!-- Global Theme Manager -->
    <script src="../../js/theme-manager.js"></script>
</head>

<body>
    <div class="flex min-h-screen">
        <!-- Mobile Header -->
        <header class="bg-gray-800 text-white flex items-center justify-between p-4 md:hidden fixed top-0 left-0 w-full z-50 shadow-md">
            <div class="flex items-center space-x-3">
                <button id="menu-toggle" class="text-white focus:outline-none">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
                <span class="text-xl font-bold">QSI</span>
            </div>
        </header>

        <!-- BACKDROP for mobile -->
        <div id="menu-backdrop" class="fixed inset-0 bg-black bg-opacity-50 hidden md:hidden z-40"></div>

        <!-- SIDEBAR -->
        <aside id="sidebar"
            class="w-64 bg-gray-800 text-white h-screen fixed md:h-screen fixed md:sticky top-0 left-0 transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50 flex flex-col shadow-lg">
            <div class="p-6 text-2xl font-bold border-b border-gray-700">
                <i class="mr-2 text-indigo-400"></i> QSI
            </div>
            <nav class="flex-1 p-4 space-y-2">
                <a href="../dashboard_with_login.html"
                    class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
                    <i class="fas fa-chart-pie mr-3"></i>Dashboard
                </a>
                <div>
                    <button id="documents-dropdown-btn"
                        class="w-full flex justify-between items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 text-left">
                        <span class="flex items-center"><i class="fas fa-file-invoice mr-3"></i>Sales Documents</span>
                        <i id="dropdown-icon" class="fas fa-chevron-down transform transition-transform duration-200 rotate-180"></i>
                    </button>
                    <div id="documents-dropdown-content" class="pl-8 pt-2 space-y-1">
                        <a href="../quotation/home_quotation.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Quotation</a>
                        <a href="../sales_order/home_sales_order.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Sales Order</a>
                        <a href="home_invoice.html"
                            class="block py-2 px-4 rounded transition duration-200 bg-gray-700 text-sm">Invoice</a>
                        <a href="../credit_note.html"
                            class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Credit note</a>
                    </div>
                    <div>
                        <button id="purchases-dropdown-btn"
                            class="w-full flex justify-between items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700 text-left">
                            <span class="flex items-center"><i class="fas fa-shopping-cart mr-3"></i>Purchases</span>
                            <i id="purchases-dropdown-icon" class="fas fa-chevron-down transform transition-transform duration-200"></i>
                        </button>
                        <div id="purchases-dropdown-content" class="pl-8 pt-2 space-y-1 hidden">
                            <a href="../parchase/vendor/vendors_leads.html"
                                class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Vendors Leads</a>
                            <a href="../parchase/parchase_order/home_purchase_orders.html"
                                class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Purchase Orders</a>
                            <a href="../parchase/debit notes/debit_notes.html"
                                class="block py-2 px-4 rounded transition duration-200 hover:bg-gray-700 text-sm">Debit Notes</a>
                        </div>
                    </div>
                </div>
                <a href="../manage-clients.html"
                    class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
                    <i class="fas fa-users mr-3"></i>Manage Clients
                </a>
                <a href="../settings.html"
                    class="flex items-center py-2.5 px-4 rounded transition duration-200 hover:bg-gray-700">
                    <i class="fas fa-cog mr-3"></i>Settings
                </a>
            </nav>
        </aside>

        <div id="main-content" class="flex-1 overflow-y-auto">
            <div class="w-full max-w-5xl mx-auto p-6">
                <!-- View Invoice Page -->
                <div id="view-invoice-page">
                    <main class="form-container">
                        <div class="flex justify-between items-center mb-6">
                            <div class="flex items-center gap-4">
                                <h1 class="text-3xl font-bold text-gray-800">View Invoice</h1>
                                <span class="readonly-badge">
                                    <i class="fas fa-eye"></i> Read Only
                                </span>
                                <span id="payment-status-badge" class="status-badge status-pending hidden">Pending</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <a href="home_invoice.html" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left mr-2"></i> Back to List
                                </a>
                                <button id="edit-invoice-btn" class="btn btn-success">
                                    <i class="fas fa-edit mr-2"></i> Edit
                                </button>
                                <button id="download-pdf-btn" class="btn btn-primary">
                                    <i class="fas fa-download mr-2"></i> Download PDF
                                </button>
                            </div>
                        </div>

                        <div id="alert-container"></div>

                        <div class="form-section space-y-6">
                            <!-- Invoice Info -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <div class="grid grid-cols-3 gap-2 items-center mb-4">
                                        <label class="text-gray-600 text-sm font-medium">Invoice No.</label>
                                        <div id="invoice-no" class="display-field col-span-2">-</div>
                                    </div>

                                    <div class="grid grid-cols-3 gap-2 items-center mb-4">
                                        <label class="text-gray-600 text-sm font-medium">Invoice Date</label>
                                        <div id="invoice-date" class="display-field col-span-2">-</div>
                                    </div>

                                    <div class="grid grid-cols-3 gap-2 items-center mb-4">
                                        <label class="text-gray-600 text-sm font-medium">Due Date</label>
                                        <div id="due-date" class="display-field col-span-2">-</div>
                                    </div>
                                </div>
                                <div id="logo-container"
                                    class="border-2 border-dashed rounded-lg flex flex-col items-center justify-center p-4 text-center bg-gray-50">
                                    <img id="logo-preview" src="" alt="Business Logo" class="max-w-[150px] max-h-[70px] object-contain hidden" />
                                    <div id="logo-placeholder" class="text-gray-400">
                                        <i class="fas fa-image text-2xl mb-2"></i>
                                        <span class="block text-sm">No Logo</span>
                                    </div>
                                </div>
                            </div>

                            <!-- From & To Section -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- From (Company) -->
                                <div class="border rounded-lg p-4 space-y-3 bg-gray-50">
                                    <h3 class="font-semibold text-gray-700">
                                        From <span class="text-gray-400 text-sm">(Your Details)</span>
                                    </h3>
                                    <div>
                                        <label class="text-sm font-medium text-gray-600">Business Name</label>
                                        <div id="businessName" class="display-field mt-1">-</div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">City</label>
                                            <div id="business_city" class="display-field mt-1">-</div>
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">Country</label>
                                            <div id="business_country" class="display-field mt-1">-</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- To (Client) -->
                                <div class="border rounded-lg p-4 space-y-3 bg-gray-50">
                                    <h3 class="font-semibold text-gray-700">
                                        Billed To <span class="text-gray-400 text-sm">(Client's Details)</span>
                                    </h3>
                                    <div>
                                        <label class="text-sm font-medium text-gray-600">Client Name</label>
                                        <div id="client-name" class="display-field mt-1">-</div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">City</label>
                                            <div id="client-city" class="display-field mt-1">-</div>
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-gray-600">State</label>
                                            <div id="client-state" class="display-field mt-1">-</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Items Table -->
                            <div class="p-4 rounded-lg border shadow-sm">
                                <h3 class="font-semibold text-gray-700 mb-4">Items</h3>
                                <div class="overflow-x-auto">
                                    <table class="items-table">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Item Name</th>
                                                <th>Quantity</th>
                                                <th>Rate</th>
                                                <th>Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody id="items-tbody">
                                            <!-- Items will be populated here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Totals Section -->
                            <div class="w-full flex justify-end mt-4">
                                <div class="w-96 p-4 rounded-lg border bg-gray-50 shadow-sm space-y-3">
                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-600">Subtotal</span>
                                        <span class="font-semibold text-gray-800" id="sub_total">₹0.00</span>
                                    </div>

                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-600">Tax (<span id="tax-percentage">0</span>%)</span>
                                        <span class="font-semibold text-gray-800" id="tax">₹0.00</span>
                                    </div>

                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-600">Round Off</span>
                                        <span class="font-semibold text-gray-800" id="round_off">₹0.00</span>
                                    </div>

                                    <div class="flex justify-between items-center border-t border-gray-300 pt-2">
                                        <span class="font-bold text-gray-800">Total</span>
                                        <span class="font-bold text-gray-800" id="total">₹0.00</span>
                                    </div>

                                    <div class="flex justify-between items-center">
                                        <span class="text-green-600 font-medium">Paid Amount</span>
                                        <span class="font-semibold text-green-600" id="paid_amount">₹0.00</span>
                                    </div>

                                    <div class="flex justify-between items-center border-t-2 border-black pt-2 mt-2">
                                        <span class="font-bold text-lg text-gray-800">Balance Due</span>
                                        <span class="font-bold text-lg text-red-600" id="balance_due">₹0.00</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Terms & Conditions (only shown if data exists) -->
                            <div id="terms-section" class="hidden">
                                <h3 class="font-semibold text-gray-700 mb-2">
                                    <i class="fas fa-file-contract mr-2"></i>Terms & Conditions
                                </h3>
                                <div id="terms-content" class="display-field-lg">-</div>
                            </div>

                            <!-- Notes (only shown if data exists) -->
                            <div id="notes-section" class="hidden">
                                <h3 class="font-semibold text-gray-700 mb-2">
                                    <i class="fas fa-sticky-note mr-2"></i>Notes
                                </h3>
                                <div id="notes-content" class="display-field-lg">-</div>
                            </div>

                            <!-- Signatory (only shown if data exists) -->
                            <div id="signatory-section" class="hidden">
                                <h3 class="font-semibold text-gray-700 mb-2">
                                    <i class="fas fa-signature mr-2"></i>Authorized Signatory
                                </h3>
                                <div class="border rounded-lg p-4 bg-gray-50 inline-block">
                                    <div id="signatory-image-display" class="hidden mb-2">
                                        <img id="signatory-image" src="" alt="Signature" class="max-h-16 object-contain">
                                    </div>
                                    <div id="signatory-name-display" class="text-center">
                                        <div class="border-t border-gray-400 pt-2 mt-4 w-48">
                                            <span id="signatory-name" class="font-medium text-gray-700"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </main>
                </div>

                <!-- Hidden PDF Preview Section -->
                <div id="pdf-preview-section" class="hidden">
                    <div id="invoice-pdf-content" style="
                        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                        padding: 40px;
                        background-color: white;
                        border: 1px solid #e5e7eb;
                        max-width: 800px;
                        margin: 0 auto;
                        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
                    ">
                        <!-- Header -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
                            <div>
                                <img id="pdf-logo" src="" alt="Business Logo" style="max-width: 150px; max-height: 70px; object-fit: contain;" />
                            </div>
                            <div style="text-align: right;">
                                <h1 style="font-size: 2rem; font-weight: bold; color: #374151; margin: 0 0 8px 0; text-transform: uppercase;">Invoice</h1>
                                <p style="margin: 0; font-size: 14px; color: #4b5563;"><strong>Invoice No:</strong> <span id="pdf-inv-no"></span></p>
                                <p style="margin: 0; font-size: 14px; color: #4b5563;"><strong>Date:</strong> <span id="pdf-inv-date"></span></p>
                                <p style="margin: 0; font-size: 14px; color: #4b5563;"><strong>Due Date:</strong> <span id="pdf-due-date"></span></p>
                            </div>
                        </div>

                        <!-- Address Section -->
                        <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
                            <div style="max-width: 45%;">
                                <h2 style="font-size: 14px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">From:</h2>
                                <p id="pdf-from-details" style="font-size: 14px; line-height: 1.6; color: #374151; margin: 0; white-space: pre-wrap;"></p>
                            </div>
                            <div style="max-width: 45%;">
                                <h2 style="font-size: 14px; font-weight: 600; color: #6b7280; margin-bottom: 4px;">To:</h2>
                                <p id="pdf-to-details" style="font-size: 14px; line-height: 1.6; color: #374151; margin: 0; white-space: pre-wrap;"></p>
                            </div>
                        </div>

                        <!-- Items Table -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <thead>
                                <tr style="border-bottom: 2px solid #d1d5db;">
                                    <th style="text-align: left; padding: 8px 4px; font-weight: 600; font-size: 12px; text-transform: uppercase; color: #6b7280;">Item Name</th>
                                    <th style="text-align: right; padding: 8px 4px; font-weight: 600; font-size: 12px; text-transform: uppercase; color: #6b7280;">Quantity</th>
                                    <th style="text-align: right; padding: 8px 4px; font-weight: 600; font-size: 12px; text-transform: uppercase; color: #6b7280;">Rate</th>
                                    <th style="text-align: right; padding: 8px 4px; font-weight: 600; font-size: 12px; text-transform: uppercase; color: #6b7280;">Amount</th>
                                </tr>
                            </thead>
                            <tbody id="pdf-items-tbody"></tbody>
                        </table>

                        <!-- Totals Section -->
                        <div style="display: flex; justify-content: flex-end; margin-top: 20px; margin-bottom: 40px;">
                            <div style="width: 100%; max-width: 300px;">
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px;">
                                    <span>Sub Total</span>
                                    <span id="pdf-subtotal"></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px;">
                                    <span>Tax (<span id="pdf-tax-rate"></span>%)</span>
                                    <span id="pdf-tax"></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px;">
                                    <span>Round Off</span>
                                    <span id="pdf-round-off"></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; border-top: 1px solid #d1d5db;">
                                    <span style="font-weight: 600;">Total</span>
                                    <span id="pdf-total" style="font-weight: 600;"></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; color: #059669;">
                                    <span>Amount Paid</span>
                                    <span id="pdf-paid-amount"></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; padding-top: 12px; margin-top: 8px; border-top: 2px solid #111827; font-weight: bold; font-size: 16px;">
                                    <span>Balance Due</span>
                                    <span id="pdf-balance-due" style="color: #dc2626;"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer: Notes, Terms, Signature -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                            <div style="max-width: 60%;">
                                <div id="pdf-notes-block" class="hidden" style="margin-bottom: 16px;">
                                    <h3 style="font-weight: 600; margin-bottom: 4px; font-size: 14px;">Notes</h3>
                                    <p id="pdf-notes" style="font-size: 13px; color: #4b5563; white-space: pre-wrap; margin: 0;"></p>
                                </div>
                                <div id="pdf-terms-block" class="hidden">
                                    <h3 style="font-weight: 600; margin-bottom: 4px; font-size: 14px;">Terms and Conditions</h3>
                                    <p id="pdf-terms" style="font-size: 13px; color: #4b5563; white-space: pre-wrap; margin: 0;"></p>
                                </div>
                            </div>
                            <div id="pdf-signature-area" class="hidden" style="text-align: center; width: 200px;">
                                <div id="pdf-signature-image-space" style="height: 60px; margin-bottom: 8px;"></div>
                                <div style="border-top: 1px solid #6b7280; padding-top: 4px; font-size: 12px; color: #6b7280; margin-bottom: 4px;">Authorized Signatory</div>
                                <p id="pdf-signatory-name" style="font-weight: 600; margin: 0;"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const API_BASE_URL = "https://api.fornowauto.com/api";
            const COMPANY_API_URL = `${API_BASE_URL}/companies`;
            const INVOICE_API_URL = `${API_BASE_URL}/invoic`;

            const alertContainer = document.getElementById("alert-container");
            const editInvoiceBtn = document.getElementById("edit-invoice-btn");
            const downloadPdfBtn = document.getElementById("download-pdf-btn");
            const menuToggle = document.getElementById("menu-toggle");
            const sidebar = document.getElementById("sidebar");
            const menuBackdrop = document.getElementById("menu-backdrop");

            // Get invoice ID from URL
            const urlParams = new URLSearchParams(window.location.search);
            const INVOICE_ID = urlParams.get("id");

            let invoiceData = null;
            let companyData = null;

            // Mobile menu toggle
            if (menuToggle && sidebar && menuBackdrop) {
                menuToggle.addEventListener("click", () => {
                    sidebar.classList.toggle("-translate-x-full");
                    menuBackdrop.classList.toggle("hidden");
                });

                menuBackdrop.addEventListener("click", () => {
                    sidebar.classList.add("-translate-x-full");
                    menuBackdrop.classList.add("hidden");
                });
            }

            // === Utility Functions ===
            function showAlert(message, type = "success", duration = 5000) {
                if (!alertContainer) return;
                const alertDiv = document.createElement("div");
                alertDiv.className = `alert alert-${type}`;
                alertDiv.textContent = message;
                alertContainer.innerHTML = '';
                alertContainer.appendChild(alertDiv);
                setTimeout(() => alertDiv.remove(), duration);
            }

            function getAuthHeaders() {
                const token = localStorage.getItem("token");
                return token ? { 'Authorization': `Bearer ${token}` } : null;
            }

            async function safeFetch(url, opts = {}) {
                const headers = Object.assign({}, opts.headers || {});
                const authHeaders = getAuthHeaders();
                if (!authHeaders) {
                    alert("Authentication token not found. Please log in.");
                    window.location.href = '../../index.html';
                    throw new Error("Authentication token not found.");
                }
                Object.assign(headers, authHeaders);
                if (opts.body && !(opts.body instanceof FormData) && !headers["Content-Type"]) {
                    headers["Content-Type"] = "application/json";
                }
                try {
                    const res = await fetch(url, { ...opts, headers });
                    const text = await res.text();
                    let data;
                    try { data = text ? JSON.parse(text) : null; } catch { data = text; }
                    if (!res.ok) {
                        if (res.status === 401) {
                            alert("Session expired. Please log in again.");
                            localStorage.removeItem('token');
                            window.location.href = '../../index.html';
                            throw new Error("Session expired");
                        }
                        throw new Error(data?.message || res.statusText || "Request failed");
                    }
                    return data;
                } catch (err) {
                    console.error(err);
                    throw err;
                }
            }

            function escapeHtml(str) {
                if (!str) return "";
                return str.replace(/[&<>"']/g, function (m) {
                    return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m];
                });
            }

            function formatDate(dateStr) {
                if (!dateStr) return '-';
                const date = new Date(dateStr);
                return date.toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            // === Load Company Details ===
            async function loadCompany() {
                try {
                    const companies = await safeFetch(COMPANY_API_URL, { method: "GET" });
                    if (Array.isArray(companies) && companies.length > 0) {
                        companyData = companies[0];
                        document.getElementById("businessName").textContent = companyData.company_name || "-";
                        document.getElementById("business_city").textContent = companyData.address?.city || "-";
                        document.getElementById("business_country").textContent = companyData.address?.country || "-";

                        if (companyData.logo) {
                            const logoPreview = document.getElementById("logo-preview");
                            const logoPlaceholder = document.getElementById("logo-placeholder");
                            logoPreview.src = companyData.logo;
                            logoPreview.classList.remove("hidden");
                            logoPlaceholder.classList.add("hidden");
                        }
                    }
                } catch (err) {
                    console.error("Error loading company:", err);
                }
            }

            // === Populate View Page ===
            function populateViewPage(invoice) {
                if (!invoice) {
                    showAlert("Invoice data not found.", "error");
                    return;
                }

                invoiceData = invoice;

                // Invoice Info
                document.getElementById("invoice-no").textContent = invoice.invoice_no || invoice._id || "-";
                document.getElementById("invoice-date").textContent = formatDate(invoice.date);
                document.getElementById("due-date").textContent = formatDate(invoice.due_date);

                // Payment Status Badge
                const statusBadge = document.getElementById("payment-status-badge");
                const total = invoice.total || 0;
                const paidAmount = invoice.paid_amount || 0;
                const balanceDue = total - paidAmount;

                if (statusBadge) {
                    statusBadge.classList.remove("hidden");
                    if (balanceDue <= 0) {
                        statusBadge.textContent = "Paid";
                        statusBadge.className = "status-badge status-paid";
                    } else {
                        const dueDate = new Date(invoice.due_date);
                        const today = new Date();
                        if (dueDate < today) {
                            statusBadge.textContent = "Overdue";
                            statusBadge.className = "status-badge status-overdue";
                        } else {
                            statusBadge.textContent = "Pending";
                            statusBadge.className = "status-badge status-pending";
                        }
                    }
                }

                // Client Info
                const clientName = invoice.to?.client_name || "-";
                const clientCity = invoice.to?.address?.city || invoice.to?.address?.['city/town'] || "-";
                const clientState = invoice.to?.address?.state || "-";

                document.getElementById("client-name").textContent = clientName;
                document.getElementById("client-city").textContent = clientCity;
                document.getElementById("client-state").textContent = clientState;

                // Tax Percentage
                document.getElementById("tax-percentage").textContent = invoice.tax_percentage || 0;

                // Items
                const tbody = document.getElementById("items-tbody");
                tbody.innerHTML = "";

                if (Array.isArray(invoice.items) && invoice.items.length > 0) {
                    invoice.items.forEach((item, index) => {
                        const tr = document.createElement("tr");
                        tr.innerHTML = `
                            <td>${index + 1}</td>
                            <td>
                                <div class="font-medium">${escapeHtml(item.item_name)}</div>
                                ${item.description ? `<div class="item-description">${escapeHtml(item.description)}</div>` : ''}
                            </td>
                            <td>${item.quantity || 0}</td>
                            <td>₹${(item.rate || 0).toFixed(2)}</td>
                            <td>₹${(item.amount || 0).toFixed(2)}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-gray-500 py-4">No items found</td></tr>';
                }

                // Totals
                const subtotal = invoice.sub_total || 0;
                const tax = invoice.tax || 0;
                const roundOff = invoice.round_off || 0;

                document.getElementById("sub_total").textContent = `₹${subtotal.toFixed(2)}`;
                document.getElementById("tax").textContent = `₹${tax.toFixed(2)}`;
                document.getElementById("round_off").textContent = `₹${roundOff.toFixed(2)}`;
                document.getElementById("total").textContent = `₹${Math.round(total)}`;
                document.getElementById("paid_amount").textContent = `₹${paidAmount.toFixed(2)}`;
                document.getElementById("balance_due").textContent = `₹${Math.round(balanceDue)}`;

                // Change balance due color based on value
                const balanceDueEl = document.getElementById("balance_due");
                if (balanceDue <= 0) {
                    balanceDueEl.classList.remove("text-red-600");
                    balanceDueEl.classList.add("text-green-600");
                    if (balanceDue === 0) {
                        balanceDueEl.textContent = "₹0 (Paid)";
                    }
                }

                // Terms & Conditions
                if (invoice.terms_and_condition) {
                    document.getElementById("terms-section").classList.remove("hidden");
                    document.getElementById("terms-content").textContent = invoice.terms_and_condition;
                }

                // Notes
                if (invoice.notes) {
                    document.getElementById("notes-section").classList.remove("hidden");
                    document.getElementById("notes-content").textContent = invoice.notes;
                }

                // Signatory
                if (invoice.signatory || invoice.signatory_image) {
                    document.getElementById("signatory-section").classList.remove("hidden");

                    if (invoice.signatory_image) {
                        document.getElementById("signatory-image-display").classList.remove("hidden");
                        document.getElementById("signatory-image").src = invoice.signatory_image;
                    }

                    if (invoice.signatory) {
                        document.getElementById("signatory-name").textContent = invoice.signatory;
                    }
                }

                // Populate PDF preview section
                populatePdfPreview(invoice);
            }

            // === Populate PDF Preview ===
            function populatePdfPreview(invoice) {
                // Logo
                if (companyData?.logo) {
                    document.getElementById("pdf-logo").src = companyData.logo;
                }

                // Invoice details
                document.getElementById("pdf-inv-no").textContent = invoice.invoice_no || "-";
                document.getElementById("pdf-inv-date").textContent = formatDate(invoice.date);
                document.getElementById("pdf-due-date").textContent = formatDate(invoice.due_date);

                // From address
                const fromAddress = [
                    companyData?.company_name || '',
                    companyData?.address?.street || '',
                    [companyData?.address?.city, companyData?.address?.state, companyData?.address?.postalCode].filter(Boolean).join(', '),
                    companyData?.address?.country || ''
                ].filter(Boolean).join('\n');
                document.getElementById("pdf-from-details").textContent = fromAddress;

                // To address
                const toAddress = [
                    invoice.to?.client_name || '',
                    invoice.to?.address?.street || '',
                    [invoice.to?.address?.city || invoice.to?.address?.['city/town'], invoice.to?.address?.state, invoice.to?.address?.pincode].filter(Boolean).join(', '),
                    invoice.to?.address?.country || ''
                ].filter(Boolean).join('\n');
                document.getElementById("pdf-to-details").textContent = toAddress;

                // Items with inline styles
                const pdfTbody = document.getElementById("pdf-items-tbody");
                pdfTbody.innerHTML = "";
                (invoice.items || []).forEach(item => {
                    const tr = document.createElement("tr");
                    tr.style.borderBottom = "1px solid #e5e7eb";
                    tr.innerHTML = `
                        <td style="padding: 12px 4px; font-size: 14px;">${escapeHtml(item.item_name)}${item.description ? `<br><span style="font-size: 12px; color: #6b7280;">${escapeHtml(item.description)}</span>` : ''}</td>
                        <td style="padding: 12px 4px; font-size: 14px; text-align: right;">${item.quantity || 0}</td>
                        <td style="padding: 12px 4px; font-size: 14px; text-align: right;">₹${(item.rate || 0).toFixed(2)}</td>
                        <td style="padding: 12px 4px; font-size: 14px; text-align: right;">₹${(item.amount || 0).toFixed(2)}</td>
                    `;
                    pdfTbody.appendChild(tr);
                });

                // Totals
                const total = invoice.total || 0;
                const paidAmount = invoice.paid_amount || 0;
                const balanceDue = total - paidAmount;

                document.getElementById("pdf-subtotal").textContent = `₹${(invoice.sub_total || 0).toFixed(2)}`;
                document.getElementById("pdf-tax-rate").textContent = invoice.tax_percentage || 0;
                document.getElementById("pdf-tax").textContent = `₹${(invoice.tax || 0).toFixed(2)}`;
                document.getElementById("pdf-round-off").textContent = `₹${(invoice.round_off || 0).toFixed(2)}`;
                document.getElementById("pdf-total").textContent = `₹${Math.round(total)}`;
                document.getElementById("pdf-paid-amount").textContent = `₹${paidAmount.toFixed(2)}`;
                document.getElementById("pdf-balance-due").textContent = `₹${Math.round(balanceDue)}`;

                // Terms
                if (invoice.terms_and_condition) {
                    document.getElementById("pdf-terms-block").classList.remove("hidden");
                    document.getElementById("pdf-terms-block").style.display = "block";
                    document.getElementById("pdf-terms").textContent = invoice.terms_and_condition;
                }

                // Notes
                if (invoice.notes) {
                    document.getElementById("pdf-notes-block").classList.remove("hidden");
                    document.getElementById("pdf-notes-block").style.display = "block";
                    document.getElementById("pdf-notes").textContent = invoice.notes;
                }

                // Signatory
                if (invoice.signatory || invoice.signatory_image) {
                    document.getElementById("pdf-signature-area").classList.remove("hidden");
                    document.getElementById("pdf-signature-area").style.display = "block";

                    if (invoice.signatory_image) {
                        document.getElementById("pdf-signature-image-space").innerHTML = `<img src="${invoice.signatory_image}" alt="Signature" style="max-height: 100%; max-width: 100%; object-fit: contain;">`;
                    }

                    if (invoice.signatory) {
                        document.getElementById("pdf-signatory-name").textContent = invoice.signatory;
                    }
                }
            }

            // === Edit Button Handler ===
            editInvoiceBtn?.addEventListener("click", () => {
                if (INVOICE_ID) {
                    window.location.href = `edit_invoice.html?id=${INVOICE_ID}`;
                }
            });

            // === Download PDF Handler ===
            downloadPdfBtn?.addEventListener("click", async () => {
                const pdfSection = document.getElementById("pdf-preview-section");
                const element = document.getElementById("invoice-pdf-content");

                if (!element) {
                    showAlert("Could not generate PDF.", "error");
                    return;
                }

                try {
                    // Show the section temporarily for rendering
                    pdfSection.classList.remove("hidden");
                    pdfSection.style.position = "absolute";
                    pdfSection.style.left = "-9999px";
                    pdfSection.style.top = "0";

                    // Wait for images to load
                    await new Promise(resolve => setTimeout(resolve, 500));

                    const canvas = await html2canvas(element, {
                        scale: 1.5,
                        useCORS: true,
                        backgroundColor: '#ffffff',
                        logging: false
                    });

                    const { jsPDF } = window.jspdf;
                    const pdf = new jsPDF("p", "mm", "a4");
                    const imgData = canvas.toDataURL("image/jpeg", 0.95);

                    const pageWidth = pdf.internal.pageSize.getWidth();
                    const pageHeight = pdf.internal.pageSize.getHeight();
                    const imgProps = pdf.getImageProperties(imgData);
                    const pdfHeight = (imgProps.height * pageWidth) / imgProps.width;

                    // Handle multi-page if content is longer than one page
                    let heightLeft = pdfHeight;
                    let position = 0;

                    pdf.addImage(imgData, "JPEG", 0, position, pageWidth, pdfHeight);
                    heightLeft -= pageHeight;

                    while (heightLeft > 0) {
                        position = heightLeft - pdfHeight;
                        pdf.addPage();
                        pdf.addImage(imgData, "JPEG", 0, position, pageWidth, pdfHeight);
                        heightLeft -= pageHeight;
                    }

                    let clientName = invoiceData?.to?.client_name || "Client";
                    clientName = clientName.replace(/[^a-zA-Z0-9-_ ]/g, "").trim().replace(/\s+/g, "_");
                    const invNo = invoiceData?.invoice_no || "Invoice";
                    const filename = `${clientName}_${invNo}.pdf`;

                    pdf.save(filename);

                    // Hide the section again
                    pdfSection.classList.add("hidden");
                    pdfSection.style.position = "";
                    pdfSection.style.left = "";
                    pdfSection.style.top = "";

                    showAlert("PDF downloaded successfully!", "success", 3000);

                } catch (err) {
                    console.error("PDF generation error:", err);
                    showAlert("Error generating PDF: " + err.message, "error");
                }
            });

            // === Sidebar Dropdowns ===
            const dropdownBtn = document.getElementById("documents-dropdown-btn");
            const dropdownContent = document.getElementById("documents-dropdown-content");
            const dropdownIcon = document.getElementById("dropdown-icon");
            dropdownBtn?.addEventListener("click", () => {
                dropdownContent?.classList.toggle("hidden");
                dropdownIcon?.classList.toggle("rotate-180");
            });

            const purchasesDropdownBtn = document.getElementById('purchases-dropdown-btn');
            purchasesDropdownBtn?.addEventListener('click', () => {
                document.getElementById('purchases-dropdown-content')?.classList.toggle('hidden');
                document.getElementById('purchases-dropdown-icon')?.classList.toggle('rotate-180');
            });

            // === Initialize ===
            (async function init() {
                if (!INVOICE_ID) {
                    showAlert("No invoice ID provided.", "error");
                    return;
                }

                try {
                    showAlert("Loading invoice...", "info", 2000);

                    await loadCompany();

                    const invoice = await safeFetch(`${INVOICE_API_URL}/${INVOICE_ID}`, { method: "GET" });

                    if (!invoice) {
                        throw new Error("Invoice not found.");
                    }

                    populateViewPage(invoice);

                } catch (err) {
                    console.error("Initialization failed:", err);
                    showAlert(`Error loading invoice: ${err.message}`, "error");
                }
            })();
        });
    </script>
</body>

</html>